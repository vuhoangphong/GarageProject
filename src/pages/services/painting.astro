---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
---

<BaseLayout
  pageTitle="塗装・美装サービス | 京都のフォンカー"
  metaDescription="京都のフォンカーの塗装・美装サービス。高品質な塗装技術でお車を美しく仕上げます。京都で車の塗装をお探しなら当社へお任せください。"
  metaKeywords="塗装, 美装, 全塗装, 部分塗装, 京都, 京都のフォンカー"
  pageUrl="https://garage-project-rose.vercel.app/services/painting"
>
  <Header />
  
  <main>
    <section class="service-hero">
      <div class="hero-content">
        <h1 class="hero-title lang" data-ja="塗装・美装サービス" data-vn="Dịch vụ sơn xe">塗装・美装サービス</h1>
        <p class="hero-subtitle lang" 
           data-ja="高品質な塗装技術で、お車を美しく仕上げます"
           data-vn="Với công nghệ sơn chất lượng cao, chúng tôi hoàn thiện xe của bạn một cách đẹp mắt">
          高品質な塗装技術で、お車を美しく仕上げます
        </p>
      </div>
      <div class="hero-image">
        <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSPG_v2lKnET2pMaYaVzL4VriZ880pHPjNYIg&s" 
             alt="塗装・美装サービス" />
      </div>
    </section>

    <section class="service-details">
      <div class="container">
        <div class="service-grid">
          <div class="service-card">
            <h3 class="lang" data-ja="全塗装" data-vn="Sơn toàn bộ">全塗装</h3>
            <p class="lang" 
               data-ja="お車全体を新品同様の美しさに仕上げます。色褪せやキズが気になる方におすすめです。"
               data-vn="Hoàn thiện toàn bộ xe đẹp như mới. Được khuyến nghị cho những ai quan tâm đến việc phai màu và trầy xước.">
              お車全体を新品同様の美しさに仕上げます。色褪せやキズが気になる方におすすめです。
            </p>
            <ul>
              <li class="lang" data-ja="下地処理から仕上げまで" data-vn="Từ xử lý nền đến hoàn thiện">下地処理から仕上げまで</li>
              <li class="lang" data-ja="高品質塗料の使用" data-vn="Sử dụng sơn chất lượng cao">高品質塗料の使用</li>
              <li class="lang" data-ja="色合わせ技術" data-vn="Công nghệ phối màu">色合わせ技術</li>
              <li class="lang" data-ja="長期保証付き" data-vn="Có bảo hành dài hạn">長期保証付き</li>
            </ul>
          </div>

          <div class="service-card">
            <h3 class="lang" data-ja="部分塗装" data-vn="Sơn từng phần">部分塗装</h3>
            <p class="lang" 
               data-ja="傷やへこみの修理後の塗装や、部分的な色褪せの修正を行います。コストパフォーマンスに優れています。"
               data-vn="Sơn sau khi sửa chữa trầy xước và móp dented, hoặc chỉnh sửa phai màu từng phần. Hiệu quả về chi phí tuyệt vời.">
              傷やへこみの修理後の塗装や、部分的な色褪せの修正を行います。コストパフォーマンスに優れています。
            </p>
            <ul>
              <li class="lang" data-ja="傷修理後の塗装" data-vn="Sơn sau sửa trầy xước">傷修理後の塗装</li>
              <li class="lang" data-ja="部分的色褪せ修正" data-vn="Chỉnh sửa phai màu từng phần">部分的色褪せ修正</li>
              <li class="lang" data-ja="完全色合わせ" data-vn="Phối màu hoàn hảo">完全色合わせ</li>
              <li class="lang" data-ja="迅速対応" data-vn="Đáp ứng nhanh chóng">迅速対応</li>
            </ul>
          </div>

          <div class="service-card">
            <h3 class="lang" data-ja="特殊塗装" data-vn="Sơn đặc biệt">特殊塗装</h3>
            <p class="lang" 
               data-ja="メタリック、パール、マットなど、特殊な塗装も承ります。お客様のこだわりにお応えします。"
               data-vn="Chúng tôi cũng nhận sơn đặc biệt như metallic, pearl, matte. Đáp ứng sự cầu kỳ của khách hàng.">
              メタリック、パール、マットなど、特殊な塗装も承ります。お客様のこだわりにお応えします。
            </p>
            <ul>
              <li class="lang" data-ja="メタリック塗装" data-vn="Sơn metallic">メタリック塗装</li>
              <li class="lang" data-ja="パール塗装" data-vn="Sơn pearl">パール塗装</li>
              <li class="lang" data-ja="マット塗装" data-vn="Sơn matte">マット塗装</li>
              <li class="lang" data-ja="カスタムカラー" data-vn="Màu tùy chỉnh">カスタムカラー</li>
            </ul>
          </div>
        </div>

        <div class="features-section">
          <h2 class="section-title lang" data-ja="当社の塗装技術の特徴" data-vn="Đặc điểm công nghệ sơn của chúng tôi">当社の塗装技術の特徴</h2>
          <div class="features-grid">
            <div class="feature-item">
              <div class="feature-icon">🎨</div>
              <h4 class="lang" data-ja="完璧な色合わせ" data-vn="Phối màu hoàn hảo">完璧な色合わせ</h4>
              <p class="lang" data-ja="最新の調色技術で元の色と完全に一致させます" data-vn="Với công nghệ pha màu mới nhất, chúng tôi khớp hoàn toàn với màu gốc">最新の調色技術で元の色と完全に一致させます</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">⚡</div>
              <h4 class="lang" data-ja="高耐久性" data-vn="Độ bền cao">高耐久性</h4>
              <p class="lang" data-ja="紫外線や雨風に強い高品質塗料を使用" data-vn="Sử dụng sơn chất lượng cao chống tia UV và mưa gió">紫外線や雨風に強い高品質塗料を使用</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">✨</div>
              <h4 class="lang" data-ja="美しい仕上がり" data-vn="Hoàn thiện đẹp mắt">美しい仕上がり</h4>
              <p class="lang" data-ja="熟練の職人による手作業で美しく仕上げます" data-vn="Hoàn thiện đẹp bằng tay nghề thủ công của thợ lành nghề">熟練の職人による手作業で美しく仕上げます</p>
            </div>
            <div class="feature-item">
              <div class="feature-icon">🛡️</div>
              <h4 class="lang" data-ja="品質保証" data-vn="Bảo hành chất lượng">品質保証</h4>
              <p class="lang" data-ja="塗装品質に自信があるからこそ長期保証を提供" data-vn="Cung cấp bảo hành dài hạn vì tự tin về chất lượng sơn">塗装品質に自信があるからこそ長期保証を提供</p>
            </div>
          </div>
        </div>

        <div class="process-section">
          <h2 class="section-title lang" data-ja="塗装の工程" data-vn="Quy trình sơn">塗装の工程</h2>
          <div class="process-timeline">
            <div class="process-item">
              <div class="process-number">1</div>
              <div class="process-content">
                <h4 class="lang" data-ja="下地処理" data-vn="Xử lý nền">下地処理</h4>
                <p class="lang" data-ja="塗装面を丁寧に研磨・清掃し、完璧な下地を作ります" data-vn="Mài và làm sạch bề mặt sơn cẩn thận, tạo nền hoàn hảo">塗装面を丁寧に研磨・清掃し、完璧な下地を作ります</p>
              </div>
            </div>
            <div class="process-item">
              <div class="process-number">2</div>
              <div class="process-content">
                <h4 class="lang" data-ja="プライマー塗布" data-vn="Phủ primer">プライマー塗布</h4>
                <p class="lang" data-ja="密着性を高めるプライマーを均一に塗布します" data-vn="Phủ primer đều để tăng độ bám dính">密着性を高めるプライマーを均一に塗布します</p>
              </div>
            </div>
            <div class="process-item">
              <div class="process-number">3</div>
              <div class="process-content">
                <h4 class="lang" data-ja="ベースコート" data-vn="Lớp sơn nền">ベースコート</h4>
                <p class="lang" data-ja="色付けのためのベースコートを慎重に塗装します" data-vn="Sơn lớp nền để tô màu một cách cẩn thận">色付けのためのベースコートを慎重に塗装します</p>
              </div>
            </div>
            <div class="process-item">
              <div class="process-number">4</div>
              <div class="process-content">
                <h4 class="lang" data-ja="クリアコート" data-vn="Lớp phủ trong">クリアコート</h4>
                <p class="lang" data-ja="艶と保護のためのクリアコートで仕上げます" data-vn="Hoàn thiện bằng lớp phủ trong để tạo độ bóng và bảo vệ">艶と保護のためのクリアコートで仕上げます</p>
              </div>
            </div>
          </div>
        </div>

        <div class="cta-section">
          <h2 class="lang" data-ja="塗装のご相談はお気軽に" data-vn="Tư vấn sơn xe thoải mái">塗装のご相談はお気軽に</h2>
          <p class="lang" 
             data-ja="お車の美しさを取り戻しませんか？無料でお見積りいたします。"
             data-vn="Bạn có muốn khôi phục vẻ đẹp của xe không? Chúng tôi báo giá miễn phí.">
            お車の美しさを取り戻しませんか？無料でお見積りいたします。
          </p>
          <a href="/#contact" class="cta-button lang" data-ja="お問い合わせ" data-vn="Liên hệ">お問い合わせ</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
.service-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40px;
  align-items: center;
  padding: 80px 20px;
  max-width: 1200px;
  margin: 0 auto;
}

.hero-title {
  font-size: clamp(28px, 5vw, 42px);
  color: var(--dark-gray);
  margin-bottom: 20px;
  font-weight: 600;
}

.hero-subtitle {
  font-size: 18px;
  color: #666;
  line-height: 1.8;
}

.hero-image img {
  width: 100%;
  height: 300px;
  object-fit: cover;
  border-radius: 12px;
  box-shadow: 0 8px 30px rgba(0,0,0,0.1);
}

.service-details {
  background: #fafafa;
  padding: 80px 20px;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
}

.service-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
  gap: 30px;
  margin-bottom: 60px;
}

.service-card {
  background: white;
  padding: 30px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
  border: 1px solid #f0f0f0;
}

.service-card h3 {
  color: var(--primary-red);
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 15px;
}

.service-card p {
  color: #666;
  line-height: 1.7;
  margin-bottom: 20px;
}

.service-card ul {
  list-style: none;
  padding: 0;
}

.service-card li {
  color: #666;
  margin-bottom: 8px;
  padding-left: 20px;
  position: relative;
}

.service-card li:before {
  content: "✓";
  color: var(--primary-red);
  font-weight: bold;
  position: absolute;
  left: 0;
}

.features-section,
.process-section {
  margin-bottom: 60px;
}

.section-title {
  text-align: center;
  font-size: 28px;
  color: var(--dark-gray);
  margin-bottom: 40px;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 30px;
}

.feature-item {
  background: white;
  padding: 30px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.feature-icon {
  font-size: 40px;
  margin-bottom: 15px;
}

.feature-item h4 {
  font-size: 18px;
  color: var(--dark-gray);
  margin-bottom: 10px;
}

.feature-item p {
  color: #666;
  font-size: 14px;
  line-height: 1.6;
}

.process-timeline {
  display: grid;
  gap: 30px;
}

.process-item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 20px;
  align-items: center;
  background: white;
  padding: 30px;
  border-radius: 12px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.process-number {
  width: 60px;
  height: 60px;
  background: linear-gradient(135deg, var(--primary-red), var(--secondary-red));
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24px;
  font-weight: bold;
}

.process-content h4 {
  font-size: 20px;
  color: var(--dark-gray);
  margin-bottom: 8px;
}

.process-content p {
  color: #666;
  line-height: 1.6;
}

.cta-section {
  background: white;
  padding: 40px;
  border-radius: 12px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0,0,0,0.05);
}

.cta-section h2 {
  color: var(--dark-gray);
  font-size: 24px;
  margin-bottom: 15px;
}

.cta-section p {
  color: #666;
  font-size: 16px;
  margin-bottom: 25px;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.cta-button {
  background: linear-gradient(135deg, var(--primary-red), var(--secondary-red));
  color: white;
  padding: 15px 30px;
  border-radius: 30px;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
  display: inline-block;
}

.cta-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(200, 16, 46, 0.3);
}

@media (max-width: 768px) {
  .service-hero {
    grid-template-columns: 1fr;
    gap: 30px;
  }
  
  .service-grid,
  .features-grid {
    grid-template-columns: 1fr;
  }
  
  .process-item {
    grid-template-columns: 1fr;
    text-align: center;
  }
}
</style>