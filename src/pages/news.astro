---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import newsList from "../data/news.json";
---

<BaseLayout
  pageTitle="最新情報・施工実績 | 京都のフォンカー (Phuong Car of Kyoto)"
  metaDescription="京都のフォンカーの最新情報と施工実績。板金塗装、車検、傷修復の施工例を写真付きでご紹介します。"
  metaKeywords="京都, フォンカー, Phuong Car, 施工実績, 最新情報, 板金塗装, 修理実績"
  pageUrl="https://garage-project-rose.vercel.app/news"
>
  <Header />

  <main class="news-page">
    <!-- Hero Banner -->
    <section class="news-hero">
      <div class="news-hero-content">
        <span class="hero-badge lang" data-ja="公式 SNS・Threads・Facebook 更新" data-vn="Cập nhật từ Threads & Facebook chính thức">公式 SNS・Threads・Facebook 更新</span>
        <h1 class="hero-title lang" data-ja="最新情報・施工実績" data-vn="Tin Mới & Hình Ảnh Thi Công">
          最新情報・施工実績
        </h1>
        <p class="hero-subtitle lang" 
           data-ja="京都のフォンカー（Phuong Car of Kyoto）の日々の板金塗装・車検・修理の実績をご紹介いたします。"
           data-vn="Hình ảnh thực tế các dự án đồng sơn, sửa chữa thân xe và phục hồi xe tại xưởng Kyoto.">
          京都のフォンカー（Phuong Car of Kyoto）の日々の板金塗装・車検・修理の実績をご紹介いたします。
        </p>

        <!-- Threads Banner Link -->
        <div class="social-hero-btns">
          <a href="https://www.facebook.com/Hfoncar/" target="_blank" rel="noopener" class="fb-profile-btn">
            <span class="fb-icon"><svg class="brand-icon fb-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/><path fill="#FFFFFF" d="M16.671 15.543l.532-3.47h-3.328v-2.25c0-.949.465-1.874 1.956-1.874h1.514V4.996s-1.374-.235-2.686-.235c-2.741 0-4.533 1.662-4.533 4.669v2.643H7.078v3.47h3.047v8.385a12.09 12.09 0 0 0 3.75 0v-8.385h2.796z"/></svg></span>
            <div class="threads-btn-text">
              <strong>Facebook (@Hfoncar)</strong>
              <span class="lang" data-ja="公式Facebookページを見る →" data-vn="Xem trang Facebook chính thức →">公式Facebookページを見る →</span>
            </div>
          </a>
          <a href="https://www.threads.com/@hfoncar0895?igshid=NTc4MTIwNjQ2YQ==" target="_blank" rel="noopener" class="threads-profile-btn">
          <span class="threads-icon"><svg class="brand-icon threads-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect width="24" height="24" rx="12" fill="#101010"/><path fill="#FFFFFF" d="M15.485 10.638c-.14-.066-.301-.119-.481-.157-.16-.689-.482-1.332-.938-1.858-.64-.738-1.5-1.123-2.486-1.123-.986 0-1.846.385-2.486 1.123-.559.645-.909 1.48-.99 2.457 0 .041-.004.083-.004.12 0 1.042.348 1.958.985 2.583.568.558 1.336.878 2.219.923.633.032 1.258-.109 1.808-.408.065.176.155.337.268.48.336.425.823.659 1.372.659.519 0 .976-.207 1.288-.584.288-.348.441-.837.441-1.417 0-1.579-.933-2.673-2.5-3.044-.241-.057-.492-.087-.745-.087-.899 0-1.698.347-2.25 1.002-.38.452-.614 1.07-.66 1.74h1.492c.038-.344.159-.646.353-.872.233-.272.569-.422.946-.422.128 0 .252.016.368.046.942.246 1.393.856 1.393 1.837 0 .285-.067.514-.194.664-.108.127-.267.197-.472.197-.197 0-.361-.077-.487-.229-.115-.138-.175-.325-.175-.556v-.219c0-.495-.145-.965-.418-1.36-.347-.502-.857-.803-1.474-.87-1.127-.123-2.185.642-2.362 1.708-.007.042-.01.085-.01.129 0 .685.228 1.288.643 1.696.384.377.905.594 1.506.626.474.025.938-.088 1.345-.327-.375-.72-.56-1.554-.56-2.455 0-.036.002-.072.003-.108.064-.783.342-1.449.782-1.956.495-.571 1.157-.866 1.916-.866.759 0 1.42.295 1.916.866.368.424.622.973.743 1.603.224.084.428.196.608.334.364.279.62.656.741 1.091.13.468.135 1.011.014 1.572-.258 1.196-.949 2.158-1.946 2.709-.817.451-1.785.689-2.798.689-1.385 0-2.623-.464-3.579-1.342-1.026-.942-1.591-2.28-1.591-3.766 0-.056.004-.112.008-.168.107-1.39.638-2.585 1.492-3.456.965-.985 2.277-1.528 3.693-1.528 1.417 0 2.729.543 3.694 1.528.461.47.818 1.037 1.066 1.68l-1.391.492a4.954 4.954 0 0 0-.769-1.258c-.689-.703-1.625-1.09-2.64-1.09-1.016 0-1.952.387-2.641 1.09-.64.653-1.036 1.564-1.116 2.628-.003.042-.006.084-.006.126 0 1.144.434 2.174 1.222 2.899.729.67 1.674 1.024 2.733 1.024.787 0 1.547-.188 2.197-.544.75-.411 1.272-1.134 1.469-2.036.085-.392.08-.755-.015-1.05-.078-.242-.231-.444-.454-.599-.187-.13-.414-.216-.677-.257z"/></svg></span>
          <div class="threads-btn-text">
            <strong>@hfoncar0895</strong>
            <span class="lang" data-ja="Threadsでリアルタイムの投稿を見る →" data-vn="Xem thêm nhiều bài đăng trên Threads →">Threadsでリアルタイムの投稿を見る →</span>
          </div>
        </a>
        </div>
      </div>
    </section>

    <!-- News Grid Section -->
    <section class="news-container">
      <div class="news-grid">
        {newsList.map((item) => (
          <article class="news-card">
            <div class="card-image-wrapper">
              <img src={item.image} alt={item.title.ja} loading="lazy" />
              <div class="card-badge-container">
                <span class="category-badge lang" data-ja={item.category.ja} data-vn={item.category.vn}>
                  {item.category.ja}
                </span>
                {item.price && (
                  <span class="price-badge">{item.price}</span>
                )}
              </div>
            </div>

            <div class="card-body">
              <div class="card-meta">
                <span class="card-date">📅 {item.date}</span>
                <span class="card-source">via Threads</span>
              </div>

              <h2 class="card-title lang" data-ja={item.title.ja} data-vn={item.title.vn}>
                {item.title.ja}
              </h2>

              <p class="card-desc lang" data-ja={item.content.ja} data-vn={item.content.vn}>
                {item.content.ja}
              </p>

              <div class="card-tags">
                {item.tags.map(tag => (
                  <span class="tag-pill">{tag}</span>
                ))}
              </div>

              <div class="card-actions">
                <a href={item.threadsUrl} target="_blank" rel="noopener" class="btn-threads">
                  <svg class="brand-icon threads-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><rect width="24" height="24" rx="12" fill="#101010"/><path fill="#FFFFFF" d="M15.485 10.638c-.14-.066-.301-.119-.481-.157-.16-.689-.482-1.332-.938-1.858-.64-.738-1.5-1.123-2.486-1.123-.986 0-1.846.385-2.486 1.123-.559.645-.909 1.48-.99 2.457 0 .041-.004.083-.004.12 0 1.042.348 1.958.985 2.583.568.558 1.336.878 2.219.923.633.032 1.258-.109 1.808-.408.065.176.155.337.268.48.336.425.823.659 1.372.659.519 0 .976-.207 1.288-.584.288-.348.441-.837.441-1.417 0-1.579-.933-2.673-2.5-3.044-.241-.057-.492-.087-.745-.087-.899 0-1.698.347-2.25 1.002-.38.452-.614 1.07-.66 1.74h1.492c.038-.344.159-.646.353-.872.233-.272.569-.422.946-.422.128 0 .252.016.368.046.942.246 1.393.856 1.393 1.837 0 .285-.067.514-.194.664-.108.127-.267.197-.472.197-.197 0-.361-.077-.487-.229-.115-.138-.175-.325-.175-.556v-.219c0-.495-.145-.965-.418-1.36-.347-.502-.857-.803-1.474-.87-1.127-.123-2.185.642-2.362 1.708-.007.042-.01.085-.01.129 0 .685.228 1.288.643 1.696.384.377.905.594 1.506.626.474.025.938-.088 1.345-.327-.375-.72-.56-1.554-.56-2.455 0-.036.002-.072.003-.108.064-.783.342-1.449.782-1.956.495-.571 1.157-.866 1.916-.866.759 0 1.42.295 1.916.866.368.424.622.973.743 1.603.224.084.428.196.608.334.364.279.62.656.741 1.091.13.468.135 1.011.014 1.572-.258 1.196-.949 2.158-1.946 2.709-.817.451-1.785.689-2.798.689-1.385 0-2.623-.464-3.579-1.342-1.026-.942-1.591-2.28-1.591-3.766 0-.056.004-.112.008-.168.107-1.39.638-2.585 1.492-3.456.965-.985 2.277-1.528 3.693-1.528 1.417 0 2.729.543 3.694 1.528.461.47.818 1.037 1.066 1.68l-1.391.492a4.954 4.954 0 0 0-.769-1.258c-.689-.703-1.625-1.09-2.64-1.09-1.016 0-1.952.387-2.641 1.09-.64.653-1.036 1.564-1.116 2.628-.003.042-.006.084-.006.126 0 1.144.434 2.174 1.222 2.899.729.67 1.674 1.024 2.733 1.024.787 0 1.547-.188 2.197-.544.75-.411 1.272-1.134 1.469-2.036.085-.392.08-.755-.015-1.05-.078-.242-.231-.444-.454-.599-.187-.13-.414-.216-.677-.257z"/></svg>
                  <span class="lang" data-ja="Threadsで見る" data-vn="Xem trên Threads">Threadsで見る</span>
                </a>
                <a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener" class="btn-line">
                  <svg class="brand-icon line-icon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="#06C755" d="M21.99 10.45c0-4.66-4.57-8.45-10.19-8.45C6.18 2 1.61 5.79 1.61 10.45c0 4.18 3.65 7.68 8.58 8.31.33.07.79.22.9.51.11.26.07.67.03.93l-.15.89c-.04.26-.2 1.01.89.55 1.08-.46 5.86-3.45 8-5.9 1.4-1.57 2.13-3.23 2.13-5.29z"/><path fill="#FFFFFF" d="M9.48 13.06H7.13a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v3.32h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47zm2.46-.47a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm4.94 0a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.4-.22l-1.74-2.45v2.2a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.16 0 .31.08.4.22l1.74 2.44V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm3.5-2.77a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47h-2.35a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h2.35c.26 0 .47.21.47.47v.27a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27z"/></svg>
                  <span class="lang" data-ja="LINEで相談" data-vn="Tư vấn LINE">LINEで相談</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <!-- Quick Contact CTA -->
      <div class="news-cta-box">
        <h3 class="lang" data-ja="お車のキズ・へこみ・板金塗装のご相談はお気軽に！" data-vn="Xe bạn bị trầy xước, móp méo hay cần sơn sửa? Liên hệ ngay!">
          お車のキズ・へこみ・板金塗装のご相談はお気軽に！
        </h3>
        <p class="lang" 
           data-ja="お見積り無料・LINEやDMから写真をお送りいただくだけで迅速にお見積もりいたします。"
           data-vn="Tư vấn & báo giá hoàn toàn miễn phí. Chỉ cần gửi hình ảnh chụp xe qua LINE hoặc điện thoại trực tiếp.">
          お見積り無料・LINEやDMから写真をお送りいただくだけで迅速にお見積もりいたします。
        </p>
        <div class="cta-actions">
          <a href="tel:+819082343176" class="cta-phone-btn">
            📞 +81 90-8234-3176
          </a>
          <a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener" class="cta-line-btn">
            <svg class="brand-icon line-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#06C755" d="M21.99 10.45c0-4.66-4.57-8.45-10.19-8.45C6.18 2 1.61 5.79 1.61 10.45c0 4.18 3.65 7.68 8.58 8.31.33.07.79.22.9.51.11.26.07.67.03.93l-.15.89c-.04.26-.2 1.01.89.55 1.08-.46 5.86-3.45 8-5.9 1.4-1.57 2.13-3.23 2.13-5.29z"/><path fill="#FFFFFF" d="M9.48 13.06H7.13a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v3.32h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47zm2.46-.47a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm4.94 0a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.4-.22l-1.74-2.45v2.2a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.16 0 .31.08.4.22l1.74 2.44V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm3.5-2.77a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47h-2.35a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h2.35c.26 0 .47.21.47.47v.27a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27z"/></svg>
            <span class="lang" data-ja="LINEで写真を送る" data-vn="Gửi hình qua LINE">LINEで写真を送る</span>
          </a>
          <a href="https://www.facebook.com/Hfoncar/" target="_blank" rel="noopener" class="cta-fb-btn">
            <svg class="brand-icon fb-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/><path fill="#FFFFFF" d="M16.671 15.543l.532-3.47h-3.328v-2.25c0-.949.465-1.874 1.956-1.874h1.514V4.996s-1.374-.235-2.686-.235c-2.741 0-4.533 1.662-4.533 4.669v2.643H7.078v3.47h3.047v8.385a12.09 12.09 0 0 0 3.75 0v-8.385h2.796z"/></svg>
            <span class="lang" data-ja="Facebookで相談" data-vn="Tư vấn qua Facebook">Facebookで相談</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>

<style>
  .news-page {
    background: #f8f9fa;
    min-height: 80vh;
  }

  .news-hero {
    background: linear-gradient(135deg, #1a1a1a 0%, #2d0006 100%);
    color: white;
    padding: 70px 20px 60px;
    text-align: center;
    position: relative;
    border-bottom: 3px solid var(--accent-gold, #d4af37);
  }

  .news-hero-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.2);
    border: 1px solid #d4af37;
    color: #f5e6b3;
    padding: 5px 14px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 15px;
    letter-spacing: 0.05em;
  }

  .hero-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    margin: 0 0 16px;
    font-family: 'Noto Serif JP', serif;
    color: white;
  }

  .hero-subtitle {
    font-size: clamp(14px, 2vw, 16px);
    color: #e0e0e0;
    line-height: 1.8;
    margin-bottom: 25px;
  }

  .social-hero-btns {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .fb-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(24, 119, 242, 0.2);
    border: 1px solid rgba(24, 119, 242, 0.6);
    padding: 10px 20px;
    border-radius: 30px;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .fb-profile-btn:hover {
    background: rgba(24, 119, 242, 0.4);
    border-color: #1877f2;
    transform: translateY(-2px);
  }

  .fb-icon {
    font-size: 22px;
  }

  .threads-profile-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.25);
    padding: 10px 20px;
    border-radius: 30px;
    color: white;
    text-decoration: none;
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .threads-profile-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #d4af37;
    transform: translateY(-2px);
  }

  .threads-icon {
    font-size: 22px;
  }

  .threads-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    font-size: 12px;
  }

  .threads-btn-text strong {
    font-size: 14px;
    color: #f5e6b3;
  }

  /* Grid Section */
  .news-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 50px 20px 80px;
  }

  .news-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 30px;
    margin-bottom: 60px;
  }

  .news-card {
    background: white;
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(0,0,0,0.06);
    border: 1px solid #eee;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .news-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.12);
  }

  .card-image-wrapper {
    position: relative;
    width: 100%;
    height: 240px;
    background: #222;
    overflow: hidden;
  }

  .card-image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .news-card:hover .card-image-wrapper img {
    transform: scale(1.05);
  }

  .card-badge-container {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    z-index: 2;
  }

  .category-badge {
    background: rgba(196, 30, 58, 0.95);
    color: white;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    backdrop-filter: blur(4px);
  }

  .price-badge {
    background: rgba(212, 175, 55, 0.95);
    color: #1a1a1a;
    font-size: 12px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .card-body {
    padding: 22px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
    color: #888;
    margin-bottom: 12px;
  }

  .card-title {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
