---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Slider from "../components/Slider.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import Reviews from "../components/Reviews.astro";
import newsList from "../data/news.json";
---

<BaseLayout
  pageTitle="京都のフォンカー (Phuong Car of Kyoto) - 自動車板金塗装・修理・車検"
  metaDescription="京都で自動車の板金塗装、車検、修理なら京都のフォンカー（Phuong Car of Kyoto）へ。熟練の技術でお客様の愛車を美しく仕上げます。"
  metaKeywords="フオンカー, フォンカー, Foncar, Phuong Car, 京都, 板金塗装, 車検, 鈑金, 塗装, 自動車修理, メンテナンス, オートリペア"
>
  <Header />
  <Slider />
  <Services />

  <main>
    <!-- Latest News / Construction Works Section from Threads -->
    <section class="latest-news" id="news">
      <div class="news-section-header">
        <h2 class="section-title">
          <span class="title-decoration">━</span>
          <span class="lang" data-ja="最新情報・施工実績" data-vn="Tin Mới & Hình Ảnh Thi Công">最新情報・施工実績</span>
          <span class="title-decoration">━</span>
        </h2>
        <p class="section-subtitle lang"
           data-ja="公式Threads（@hfoncar0895）にて日々の板金塗装・修理・車検の実績をリアルタイムで公開中！"
           data-vn="Hình ảnh thực tế các xe được phục hồi, đồng sơn & sửa chữa trực tiếp tại xưởng!">
          公式Threads（@hfoncar0895）にて日々の板金塗装・修理・車検の実績をリアルタイムで公開中！
        </p>
      </div>

      <div class="home-news-grid">
        {newsList.slice(0, 3).map((item) => (
          <article class="home-news-card">
            <div class="home-card-img">
              <img src={item.image} alt={item.title.ja} loading="lazy" />
              {item.price && <span class="home-price-tag">{item.price}</span>}
              <span class="home-cat-tag lang" data-ja={item.category.ja} data-vn={item.category.vn}>{item.category.ja}</span>
            </div>
            <div class="home-card-body">
              <span class="home-card-date">📅 {item.date}</span>
              <h3 class="home-card-title lang" data-ja={item.title.ja} data-vn={item.title.vn}>{item.title.ja}</h3>
              <p class="home-card-desc lang" data-ja={item.content.ja} data-vn={item.content.vn}>{item.content.ja}</p>
              <div class="home-card-actions">
                <a href={item.threadsUrl} target="_blank" rel="noopener" class="home-threads-link">
                  🧵 Threadsで見る
                </a>
                <a href="/news" class="home-detail-link lang" data-ja="詳細 ➜" data-vn="Chi tiết ➜">
                  詳細 ➜
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="view-all-news-container">
        <a href="/news" class="btn-view-all-news lang" data-ja="すべての最新情報・施工実績を見る ➜" data-vn="Xem tất cả tin mới & hình ảnh thi công ➜">
          すべての最新情報・施工実績を見る ➜
        </a>
      </div>
    </section>

    <!-- Google Reviews Section -->
    <Reviews />

    <section class="contact" id="contact">
      <div class="contact-header">
        <h2 class="contact-title">
          <span class="title-decoration">━</span>
          <span class="lang" data-ja="お問い合わせ" data-vn="Liên hệ"
            >お問い合わせ</span
          >
          <span class="title-decoration">━</span>
        </h2>
        <p
          class="contact-subtitle lang"
          data-ja="お気軽にご相談ください。丁寧に対応させていただきます。"
          data-vn="Xin vui lòng tư vấn thoải mái. Chúng tôi sẽ phản hồi một cách tận tâm."
        >
          お気軽にご相談ください。丁寧に対応させていただきます。
        </p>
      </div>

      <div
        class="contact-container"
        itemscope
        itemtype="https://schema.org/LocalBusiness"
      >
        <div class="contact-info-grid">
<div class="mobile-contact-info">
            <p>〒601-8212 京都府京都市南区久世上久世町411-2</p>
            <p class="lang" data-ja="月〜金  10:00 - 18:00" data-vn="Thứ 2-6  10:00 - 18:00">月〜金  10:00 - 18:00</p>
            <p class="lang" data-ja="土・日・祝  定休日" data-vn="T7, CN & Lễ  Nghỉ">土・日・祝  定休日</p>
            <br>
            <p><span class="lang" data-ja="お電話" data-vn="Điện thoại">お電話</span>  <a href="tel:+819082343176">+81 90-8234-3176</a></p>
            <p>Email: <a href="mailto:Hfoncar@gmail.com">Hfoncar@gmail.com</a></p>
            <p><a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener">🟩 LINE</a></p>
            <p><a href="https://www.threads.com/@hfoncar0895?igshid=NTc4MTIwNjQ2YQ==" target="_blank" rel="noopener">🧵 Threads</a></p>
          </div>
          
          <div class="contact-card">
            <div class="card-icon">📍</div>
            <h3 class="card-title lang" data-ja="所在地" data-vn="Địa chỉ">
              所在地
            </h3>
            <div
              class="card-content"
              itemprop="address"
              itemscope
              itemtype="https://schema.org/PostalAddress"
            >
              <p>
                <span itemprop="postalCode">〒601-8212</span><br />
                <span itemprop="addressRegion">京都府</span><span
                  itemprop="addressLocality">京都市南区</span
                ><br />
                <span itemprop="streetAddress">久世上久世町411-2</span>
              </p>
            </div>
          </div>

          <div class="contact-card">
            <div class="card-icon">🕐</div>
            <h3
              class="card-title lang"
              data-ja="営業時間"
              data-vn="Giờ làm việc"
            >
              営業時間
            </h3>
            <div class="card-content">
              <div class="hours-item">
                <span class="day lang" data-ja="月〜金" data-vn="T2-T6"
                  >月〜金</span
                >
                <span class="time">10:00 - 18:00</span>
              </div>
              <div class="hours-item closed">
                <span class="day lang" data-ja="土・日・祝" data-vn="T7, CN & Lễ">土・日・祝</span>
                <span class="time lang" data-ja="定休日" data-vn="Nghỉ">定休日</span>
              </div>
            </div>
          </div>

          <div class="contact-card">
            <div class="card-icon">📞</div>
            <h3 class="card-title lang" data-ja="お電話" data-vn="Điện thoại">
              お電話
            </h3>
            <div class="card-content">
              <p class="phone-number" itemprop="telephone">
                <a href="tel:+819082343176">+81 90-8234-3176</a>
              </p>
              <p
                class="phone-note lang"
                data-ja="お気軽にお電話ください"
                data-vn="Xin vui lòng gọi điện thoại thoải mái"
              >
                お気軽にお電話ください
              </p>
            </div>
          </div>

          <div class="contact-card">
            <div class="card-icon">📱</div>
            <h3 class="card-title lang" data-ja="SNS・連絡先" data-vn="Mạng xã hội & Liên hệ">
              SNS・連絡先
            </h3>
            <div class="card-content social-links">
              <p>Email: <a href="mailto:Hfoncar@gmail.com">Hfoncar@gmail.com</a></p>
              <p><a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener">🟩 LINE</a></p>
              <p><a href="https://www.threads.com/@hfoncar0895?igshid=NTc4MTIwNjQ2YQ==" target="_blank" rel="noopener">🧵 Threads</a></p>
            </div>
          </div>
        </div>

        <div class="map-container">
          <div class="map-header">
            <h3 class="lang" data-ja="アクセスマップ" data-vn="Bản đồ truy cập">
              アクセスマップ
            </h3>
          </div>
          <div class="map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4023.3127184618565!2d135.71085467631983!3d34.963128269085956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6001058250aa97fb%3A0x652d099f3f17d500!2z44OV44Kq44Oz44Kr44O8!5e1!3m2!1svi!2s!4v1793368415811!5m2!1svi!2s"
              width="100%"
              height="350"
              style="border:0;"
              loading="lazy"
              title="京都のフォンカー 所在地マップ"
              aria-label="Google Maps showing location of 京都のフォンカー"
            >
            </iframe>
          </div>
          <div class="map-link-container">
            <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="google-map-link lang" data-ja="Googleマップで開く" data-vn="Mở trong Google Maps">
              Googleマップで開く
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<Footer />

<style>
  .contact {
    padding: 80px 20px;
    background: white;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .contact-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-size: clamp(24px, 4vw, 32px);
    color: var(--dark-gray);
    margin-bottom: 15px;
  }

  .title-decoration {
    color: var(--primary-red);
    font-weight: 300;
  }

  .contact-subtitle {
    color: #666;
    font-size: 16px;
    font-weight: 300;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  .mobile-contact-info {
    display: none;
  }

  .contact-card {
    background: #fafafa;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #f0f0f0;
    transition: all 0.3s ease;
  }

  .contact-card:hover {
    background: white;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .card-icon {
    font-size: 32px;
    margin-bottom: 15px;
  }

  .card-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--dark-gray);
  }

  .card-content {
    color: #666;
    line-height: 1.8;
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 5px 0;
  }

  .hours-item.closed {
    color: #999;
  }

  .phone-number {
    font-size: 20px;
    font-weight: 600;
    color: var(--primary-red);
    margin-bottom: 8px;
  }

  .phone-number a {
    color: inherit;
    text-decoration: none;
  }

  .phone-number a:hover {
    text-decoration: underline;
  }

  .phone-note {
    font-size: 14px;
    color: #999;
  }

  .map-container {
    background: #fafafa;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #f0f0f0;
  }

  .map-header {
    padding: 20px;
    background: white;
    border-bottom: 1px solid #f0f0f0;
  }

  .map-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
    color: var(--dark-gray);
  }

  .map {
    overflow: hidden;
    position: relative;
    height: 350px;
    border-radius: 0 0 12px 12px;
  }

  .map iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    transition: all 0.3s ease;
  }

  .map-container:hover .map iframe {
    transform: scale(1.02);
  }

  @media (max-width: 768px) {
    .map {
      height: 280px;
    }
    
    .contact-info-grid {
      background: #fafafa;
      border-radius: 12px;
      border: 1px solid #f0f0f0;
      padding: 25px;
      margin-bottom: 50px;
      text-align: left;
      line-height: 1.8;
      color: var(--dark-gray, #333) !important;
      font-size: 15px;
    }
    
    .contact-card {
      display: none;
    }
    
    .mobile-contact-info {
      display: block;
      color: var(--dark-gray, #333) !important;
    }
    
    .mobile-contact-info p {
      margin: 8px 0;
      color: var(--dark-gray, #333) !important;
    }
    
    .mobile-contact-info a {
      color: var(--dark-gray, #333) !important;
      text-decoration: none;
      font-weight: 600;
    }
    
    .mobile-contact-info a:hover {
      text-decoration: underline;
    }
  }

  .map-link-container {
    text-align: center;
    padding: 12px;
    background: white;
    border-top: 1px solid #f0f0f0;
  }

  .google-map-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--primary-red);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition: opacity 0.3s;
  }

  .google-map-link:hover {
    opacity: 0.7;
    text-decoration: underline;
  }

  .social-links a {
    color: var(--primary-red);
    text-decoration: none;
    transition: opacity 0.3s;
  }

  .social-links a:hover {
    opacity: 0.7;
    text-decoration: underline;
  }
  /* Latest News on Home */
  .latest-news {
    padding: 70px 20px 40px;
    background: #fbfbfb;
    border-top: 1px solid #f0f0f0;
    border-bottom: 1px solid #f0f0f0;
  }

  .news-section-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-size: clamp(24px, 4vw, 32px);
    color: var(--dark-gray);
    margin-bottom: 15px;
    font-family: 'Noto Serif JP', serif;
  }

  .section-subtitle {
    color: #666;
    font-size: 15px;
    font-weight: 300;
    max-width: 650px;
    margin: 0 auto;
    line-height: 1.8;
  }

  .home-news-grid {
    max-width: 1200px;
    margin: 0 auto 40px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  .home-news-card {
    background: white;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    border: 1px solid #eee;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .home-news-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
  }

  .home-card-img {
    position: relative;
    height: 220px;
    background: #111;
    overflow: hidden;
  }

  .home-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .home-news-card:hover .home-card-img img {
    transform: scale(1.05);
  }

  .home-price-tag {
    position: absolute;
    top: 10px;
    right: 10px;
    background: rgba(212, 175, 55, 0.95);
    color: #1a1a1a;
    font-weight: 700;
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.2);
  }

  .home-cat-tag {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(200, 16, 46, 0.9);
    color: white;
    font-weight: 600;
    font-size: 11px;
    padding: 4px 10px;
    border-radius: 6px;
  }

  .home-card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .home-card-date {
    font-size: 12px;
    color: #999;
    margin-bottom: 8px;
  }

  .home-card-title {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.5;
    color: var(--dark-gray);
    font-family: 'Noto Serif JP', serif;
  }

  .home-card-desc {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
    margin-bottom: 16px;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .home-card-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid #f0f0f0;
    padding-top: 12px;
  }

  .home-threads-link {
    font-size: 13px;
    font-weight: 600;
    color: #1a1a1a;
    text-decoration: none;
    transition: color 0.2s;
  }

  .home-threads-link:hover {
    color: var(--primary-red);
    text-decoration: underline;
  }

  .home-detail-link {
    font-size: 13px;
    font-weight: 600;
    color: var(--primary-red);
    text-decoration: none;
  }

  .home-detail-link:hover {
    text-decoration: underline;
  }

  .view-all-news-container {
    text-align: center;
    margin-top: 15px;
  }

  .btn-view-all-news {
    display: inline-block;
    background: linear-gradient(135deg, var(--primary-red), var(--secondary-red));
    color: white;
    text-decoration: none;
    font-weight: 700;
    padding: 13px 32px;
    border-radius: 30px;
    font-size: 15px;
    box-shadow: 0 4px 15px rgba(200, 16, 46, 0.25);
    transition: all 0.3s ease;
  }

  .btn-view-all-news:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(200, 16, 46, 0.35);
  }
</style>

<script>
  // Apply saved language preference on page load
  document.addEventListener('DOMContentLoaded', () => {
    const savedLang = localStorage.getItem('language');
    const isVN = savedLang === 'vn';
    const contactGrid = document.querySelector('.contact-info-grid');
    
    if (isVN) {
      // Apply Vietnamese text to all elements with language data
      document.querySelectorAll(".lang, .langHeaderSerive, .langService").forEach(el => {
        const vnText = el.getAttribute("data-vn");
        if (vnText) el.textContent = vnText;
      });
      
      // Set Vietnamese attribute for mobile contact info
      if (contactGrid) {
        contactGrid.setAttribute('data-lang', 'vn');
      }
    } else {
      // Remove Vietnamese attribute for Japanese/default
      if (contactGrid) {
        contactGrid.removeAttribute('data-lang');
      }
    }
  });
  
  // Listen for language changes (if you have language toggle functionality)
  document.addEventListener('languageChanged', (event) => {
    const contactGrid = document.querySelector('.contact-info-grid');
    if (contactGrid) {
      if ((event as CustomEvent).detail === 'vn') {
        contactGrid.setAttribute('data-lang', 'vn');
      } else {
        contactGrid.removeAttribute('data-lang');
      }
    }
  });
</script>
