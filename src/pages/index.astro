---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Slider from "../components/Slider.astro";
import Services from "../components/Services.astro";
import Footer from "../components/Footer.astro";
import Reviews from "../components/Reviews.astro";
import newsList from "../data/news.json";
---

<BaseLayout
  pageTitle="京都のフォンカー (Phuong Car of Kyoto) - 自動車板金塗装・修理・車検"
  metaDescription="京都で自動車の板金塗装、車検、修理なら京都のフォンカー（Phuong Car of Kyoto）へ。熟練の技術でお客様の愛車を美しく仕上げます。"
  metaKeywords="フオンカー, フォンカー, Foncar, Phuong Car, 京都, 板金塗装, 車検, 鈑金, 塗装, 自動車修理, メンテナンス, オートリペア"
>
  <Header />
  <Slider />
  <Services />

  <main>
    <!-- Latest News / Construction Works Section from Threads -->
    <section class="latest-news" id="news">
      <div class="news-section-header">
        <h2 class="section-title">
          <span class="title-decoration">━</span>
          <span class="lang" data-ja="最新情報・施工実績" data-vn="Tin Mới & Hình Ảnh Thi Công">最新情報・施工実績</span>
          <span class="title-decoration">━</span>
        </h2>
        <p class="section-subtitle lang"
           data-ja="公式Threads（@hfoncar0895）にて日々の板金塗装・修理・車検の実績をリアルタイムで公開中！"
           data-vn="Hình ảnh thực tế các xe được phục hồi, đồng sơn & sửa chữa trực tiếp tại xưởng!">
          公式Threads（@hfoncar0895）にて日々の板金塗装・修理・車検の実績をリアルタイムで公開中！
        </p>
      </div>

      <div class="home-news-grid">
        {newsList.slice(0, 3).map((item) => (
          <article class="home-news-card">
            <div class="home-card-img">
              <img src={item.image} alt={item.title.ja} loading="lazy" />
              {item.price && <span class="home-price-tag">{item.price}</span>}
              <span class="home-cat-tag lang" data-ja={item.category.ja} data-vn={item.category.vn}>{item.category.ja}</span>
            </div>
            <div class="home-card-body">
              <span class="home-card-date">📅 {item.date}</span>
              <h3 class="home-card-title lang" data-ja={item.title.ja} data-vn={item.title.vn}>{item.title.ja}</h3>
              <p class="home-card-desc lang" data-ja={item.content.ja} data-vn={item.content.vn}>{item.content.ja}</p>
              <div class="home-card-actions">
                <a href={item.threadsUrl} target="_blank" rel="noopener" class="home-threads-link">
                  <svg class="brand-icon threads-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect width="24" height="24" rx="12" fill="#101010"/><path fill="#FFFFFF" transform="translate(3.6, 3.6) scale(0.7)" d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098c1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015c-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164c1.43 1.783 3.631 2.698 6.54 2.717c2.623-.02 4.358-.631 5.8-2.045c1.647-1.613 1.618-3.593 1.09-4.798c-.31-.71-.873-1.3-1.634-1.75c-.192 1.352-.622 2.446-1.284 3.272c-.886 1.102-2.14 1.704-3.73 1.79c-1.202.065-2.361-.218-3.259-.801c-1.063-.689-1.685-1.74-1.752-2.964c-.065-1.19.408-2.285 1.33-3.082c.88-.76 2.119-1.207 3.583-1.291a14 14 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757c-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32l-1.757-1.18c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388q.163.07.321.142c1.49.7 2.58 1.761 3.154 3.07c.797 1.82.871 4.79-1.548 7.158c-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69q-.362 0-.739.021c-1.836.103-2.98.946-2.916 2.143c.067 1.256 1.452 1.839 2.784 1.767c1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221"/></svg>
                  <span class="lang" data-ja="Threadsで見る" data-vn="Xem trên Threads">Threadsで見る</span>
                </a>
                <a href="/news" class="home-detail-link lang" data-ja="詳細 ➜" data-vn="Chi tiết ➜">
                  詳細 ➜
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>

      <div class="view-all-news-container">
        <a href="/news" class="btn-view-all-news lang" data-ja="すべての最新情報・施工実績を見る ➜" data-vn="Xem tất cả tin mới & hình ảnh thi công ➜">
          すべての最新情報・施工実績を見る ➜
        </a>
      </div>
    </section>

    <!-- Google Reviews Section -->
    <Reviews />

    <section class="contact" id="contact">
      <div class="contact-header">
        <h2 class="contact-title">
          <span class="title-decoration">━</span>
          <span class="lang" data-ja="お問い合わせ" data-vn="Liên hệ"
            >お問い合わせ</span
          >
          <span class="title-decoration">━</span>
        </h2>
        <p
          class="contact-subtitle lang"
          data-ja="お気軽にご相談ください。丁寧に対応させていただきます。"
          data-vn="Xin vui lòng tư vấn thoải mái. Chúng tôi sẽ phản hồi một cách tận tâm."
        >
          お気軽にご相談ください。丁寧に対応させていただきます。
        </p>
      </div>

      <div
        class="contact-container"
        itemscope
        itemtype="https://schema.org/LocalBusiness"
      >
        <div class="contact-info-grid">
          <!-- Card 1: Location -->
          <div class="contact-card card-loc">
            <div class="card-icon-badge badge-location">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#c8102e">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
            </div>
            <h3 class="card-title lang" data-ja="所在地" data-vn="Địa chỉ">
              所在地
            </h3>
            <div class="card-content" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
              <p class="address-zip" itemprop="postalCode">〒601-8212</p>
              <p class="address-line">
                <span itemprop="addressRegion">京都府</span><span itemprop="addressLocality">京都市南区</span><br />
                <strong itemprop="streetAddress">久世上久世町411-2</strong>
              </p>
              <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="card-link-badge lang" data-ja="Googleマップで見る ➜" data-vn="Mở Google Maps ➜">
                Googleマップで見る ➜
              </a>
            </div>
          </div>

          <!-- Card 2: Hours -->
          <div class="contact-card card-time">
            <div class="card-icon-badge badge-hours">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#d4af37">
                <path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
              </svg>
            </div>
            <h3 class="card-title lang" data-ja="営業時間" data-vn="Giờ làm việc">
              営業時間
            </h3>
            <div class="card-content">
              <div class="hours-row">
                <span class="hours-label lang" data-ja="月〜金" data-vn="T2 - T6">月〜金</span>
                <span class="hours-val">10:00 - 18:00</span>
              </div>
              <div class="hours-row closed">
                <span class="hours-label lang" data-ja="土・日・祝" data-vn="T7, CN, Lễ">土・日・祝</span>
                <span class="hours-val lang" data-ja="定休日" data-vn="Nghỉ">定休日</span>
              </div>
              <p class="hours-note lang" data-ja="※時間外のご相談もLINEにて受付中" data-vn="※Ngoài giờ vẫn nhận tư vấn qua LINE">
                ※時間外のご相談もLINEにて受付中
              </p>
            </div>
          </div>

          <!-- Card 3: Phone -->
          <div class="contact-card card-call">
            <div class="card-icon-badge badge-phone">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#003f7f">
                <path d="M20.01 15.38c-1.23 0-2.42-.2-3.53-.56a.977.977 0 0 0-1.01.24l-1.57 1.97c-2.83-1.35-5.48-3.9-6.89-6.83l1.95-1.66c.27-.28.35-.67.24-1.02-.37-1.11-.56-2.3-.56-3.53 0-.54-.45-.99-.99-.99H4.19C3.65 3 3 3.24 3 3.99 3 13.28 10.73 21 20.01 21c.71 0 .99-.63.99-1.18v-3.45c0-.54-.45-.99-.99-.99z"/>
              </svg>
            </div>
            <h3 class="card-title lang" data-ja="お電話" data-vn="Điện thoại">
              お電話
            </h3>
            <div class="card-content">
              <p class="phone-number" itemprop="telephone">
                <a href="tel:+819082343176">+81 90-8234-3176</a>
              </p>
              <p class="phone-note lang" data-ja="日本語・Tiếng Việt 対応" data-vn="Hỗ trợ tiếng Nhật & tiếng Việt">
                日本語・Tiếng Việt 対応
              </p>
              <a href="tel:+819082343176" class="phone-call-btn lang" data-ja="📞 今すぐ電話をかける" data-vn="📞 Gọi ngay cho xưởng">
                📞 今すぐ電話をかける
              </a>
            </div>
          </div>

          <!-- Card 4: SNS / Messaging -->
          <div class="contact-card card-sns">
            <div class="card-icon-badge badge-sns">
              <svg viewBox="0 0 24 24" width="26" height="26" fill="#06c755">
                <path d="M20 2H4c-1.1 0-1.99.9-1.99 2L2 22l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zM6 9h12v2H6V9zm8 5H6v-2h8v2zm4-6H6V6h12v2z"/>
              </svg>
            </div>
            <h3 class="card-title lang" data-ja="SNS・連絡先" data-vn="Mạng xã hội & Chat">
              SNS・連絡先
            </h3>
            <div class="card-content">
              <div class="sns-grid-2x2">
                <a href="mailto:Hfoncar@gmail.com" class="sns-grid-pill sns-email" title="Email: Hfoncar@gmail.com">
                  <svg class="brand-icon email-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect width="24" height="24" rx="5" fill="#EA4335"/><path fill="#FFFFFF" d="M19 6H5c-.6 0-1 .4-1 1v10c0 .6.4 1 1 1h14c.6 0 1-.4 1-1V7c0-.6-.4-1-1-1zm-.4 2.5l-6.6 4.4-6.6-4.4V7.5l6.6 4.4 6.6-4.4v1z"/></svg>
                  <span>Email</span>
                </a>
                <a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener" class="sns-grid-pill sns-line" title="LINE ID">
                  <svg class="brand-icon line-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#06C755" d="M21.99 10.45c0-4.66-4.57-8.45-10.19-8.45C6.18 2 1.61 5.79 1.61 10.45c0 4.18 3.65 7.68 8.58 8.31.33.07.79.22.9.51.11.26.07.67.03.93l-.15.89c-.04.26-.2 1.01.89.55 1.08-.46 5.86-3.45 8-5.9 1.4-1.57 2.13-3.23 2.13-5.29z"/><path fill="#FFFFFF" d="M9.48 13.06H7.13a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v3.32h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47zm2.46-.47a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm4.94 0a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.4-.22l-1.74-2.45v2.2a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.16 0 .31.08.4.22l1.74 2.44V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm3.5-2.77a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47h-2.35a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h2.35c.26 0 .47.21.47.47v.27a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27z"/></svg>
                  <span>LINE</span>
                </a>
                <a href="https://www.facebook.com/Hfoncar/" target="_blank" rel="noopener" class="sns-grid-pill sns-facebook" title="Facebook @Hfoncar">
                  <svg class="brand-icon fb-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/><path fill="#FFFFFF" d="M16.671 15.543l.532-3.47h-3.328v-2.25c0-.949.465-1.874 1.956-1.874h1.514V4.996s-1.374-.235-2.686-.235c-2.741 0-4.533 1.662-4.533 4.669v2.643H7.078v3.47h3.047v8.385a12.09 12.09 0 0 0 3.75 0v-8.385h2.796z"/></svg>
                  <span>Facebook</span>
                </a>
                <a href="https://www.threads.com/@hfoncar0895?igshid=NTc4MTIwNjQ2YQ==" target="_blank" rel="noopener" class="sns-grid-pill sns-threads" title="Threads @hfoncar0895">
                  <svg class="brand-icon threads-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><rect width="24" height="24" rx="12" fill="#101010"/><path fill="#FFFFFF" transform="translate(3.6, 3.6) scale(0.7)" d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098c1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015c-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164c1.43 1.783 3.631 2.698 6.54 2.717c2.623-.02 4.358-.631 5.8-2.045c1.647-1.613 1.618-3.593 1.09-4.798c-.31-.71-.873-1.3-1.634-1.75c-.192 1.352-.622 2.446-1.284 3.272c-.886 1.102-2.14 1.704-3.73 1.79c-1.202.065-2.361-.218-3.259-.801c-1.063-.689-1.685-1.74-1.752-2.964c-.065-1.19.408-2.285 1.33-3.082c.88-.76 2.119-1.207 3.583-1.291a14 14 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757c-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32l-1.757-1.18c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388q.163.07.321.142c1.49.7 2.58 1.761 3.154 3.07c.797 1.82.871 4.79-1.548 7.158c-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69q-.362 0-.739.021c-1.836.103-2.98.946-2.916 2.143c.067 1.256 1.452 1.839 2.784 1.767c1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221"/></svg>
                  <span>Threads</span>
                </a>
              </div>
              <p class="sns-grid-note lang" data-ja="写真送信でのお見積り歓迎！" data-vn="Gửi ảnh để nhận báo giá nhanh!">
                写真送信でのお見積り歓迎！
              </p>
            </div>
          </div>
        </div>

        <div class="map-container">
          <div class="map-header">
            <h3 class="lang" data-ja="アクセスマップ" data-vn="Bản đồ truy cập">
              アクセスマップ
            </h3>
          </div>
          <div class="map">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d4023.3127184618565!2d135.71085467631983!3d34.963128269085956!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x6001058250aa97fb%3A0x652d099f3f17d500!2z44OV44Kq44Oz44Kr44O8!5e1!3m2!1svi!2s!4v1793368415811!5m2!1svi!2s"
              width="100%"
              height="350"
              style="border:0;"
              loading="lazy"
              title="京都のフォンカー 所在地マップ"
              aria-label="Google Maps showing location of 京都のフォンカー"
            >
            </iframe>
          </div>
          <div class="map-link-container">
            <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="google-map-link lang" data-ja="Googleマップで開く" data-vn="Mở trong Google Maps">
              Googleマップで開く
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<Footer />

<style>
  .contact {
    padding: 80px 20px;
    background: white;
  }

  .contact-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .contact-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-size: clamp(24px, 4vw, 32px);
    color: var(--dark-gray);
    margin-bottom: 15px;
  }

  .title-decoration {
    color: var(--primary-red);
    font-weight: 300;
  }

  .contact-subtitle {
    color: #666;
    font-size: 16px;
    font-weight: 300;
    max-width: 600px;
    margin: 0 auto;
  }

  .contact-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .contact-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
  }

  .mobile-contact-info {
    display: none;
  }

  .contact-card {
    background: #fafafa;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    border: 1px solid #f0f0f0;
    transition: all 0.3s ease;
  }

  .contact-card:hover {
    background: white;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    transform: translateY(-2px);
  }

  .card-icon {
    font-size: 32px;
    margin-bottom: 15px;
  }

  .card-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 20px;
    color: var(--dark-gray);
  }

  .card-content {
    color: #666;
    line-height: 1.8;
  }

  .hours-item {
    display: flex;
    justify-content: space-between;
    margin-bottom: 8px;
    padding: 5px 0;
  }

  .hours-item.closed {
    color: #999;
  }

  .phone-number {
    font-size: 20px;
    font-weight: 600;
    color: var(--primary-red);
    margin-bottom: 8px;
  }

  .phone-number a {
    color: inherit;
    text-decoration: none;
  }

  .phone-number a:hover {
    text-decoration: underline;
  }

  .phone-note {
    font-size: 14px;
    color: #999;
  }

  .map-container {
    background: #fafafa;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid #f0f0f0;
  }

  .map-header {
    padding: 20px;
    background: white;
    border-bottom: 1px solid #f0f0f0;
  }

  .map-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 600;
