---
import "../styles/style.css";

export interface Props {
  pageTitle?: string;
  metaDescription?: string;
  metaKeywords?: string;
  socialImage?: string;
  pageUrl?: string;
}

const {
  pageTitle = "フオンカー (Foncar) | 京都の自動車板金塗装・キズへこみ修理・車検【京都のフォンカー】",
  metaDescription = "京都のフォンカー（フオンカー / Foncar - Phuong Car of Kyoto）は京都の自動車板金塗装、車検、修理専門店です。熟練の技術でお客様の愛車を丁寧にサポートいたします。",
  metaKeywords = "フオンカー, フォンカー, Foncar, Phuong Car, 京都, 板金塗装, 鈑金, 塗装, 車検, 自動車修理, メンテナンス",
  socialImage = "https://garage-project-rose.vercel.app/social-preview.jpg",
  pageUrl = "https://garage-project-rose.vercel.app/"
} = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Japanese Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Noto+Serif+JP:wght@400;500;700&family=M+PLUS+1p:wght@400;500;700;900&family=Montserrat:wght@700;800;900&family=Kosugi+Maru&display=swap" rel="stylesheet">
    
    <style>
      :root {
        --primary-red: #c8102e;
        --secondary-red: #8b0000;
        --accent-gold: #d4af37;
        --dark-gray: #2c2c2c;
        --light-gray: #f7f7f7;
        --border-color: #e6e6e6;
        --shadow: 0 2px 8px rgba(0,0,0,0.08);
        --japanese-blue: #003f7f;
        --japanese-green: #006b3c;
      }

      body {
        font-family: 'Noto Sans JP', 'Hiragino Kaku Gothic ProN', 'Hiragino Sans', Meiryo, sans-serif;
        font-weight: 400;
        line-height: 1.8;
        letter-spacing: 0.05em;
        margin: 0;
        padding: 0;
      }

      h1, h2, h3 {
        font-family: 'Noto Serif JP', 'Times New Roman', serif;
        font-weight: 500;
        letter-spacing: 0.1em;
      }

      p {
        margin-bottom: 1.2em;
      }
    </style>
    
    <!-- Primary SEO -->
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={metaKeywords} />
    <meta name="author" content="京都のフォンカー" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="2tNVvDi2fkZqpISzRQFoOk_QVuj3mGfr77oZZ1JPNnk" />
    
    <!-- Link Relations -->
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="ja" href={pageUrl} />
    <link rel="alternate" hreflang="vi" href={pageUrl + "?lang=vn"} />
    
    <!-- Social Media Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="京都のフォンカー" />
    <meta property="og:locale" content="ja_JP" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />
    
        <!-- Google Site Identity Schema -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "フオンカー (Foncar)",
      "alternateName": ["京都のフォンカー", "フオンカー", "Foncar", "Phuong Car of Kyoto"],
      "url": "https://garage-project-rose.vercel.app/"
    }
    </script>

    <!-- Business Schema with Google Review Rating -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "AutoRepair",
      "name": "フオンカー / 京都のフォンカー (Foncar)",
      "alternateName": ["フオンカー", "フォンカー", "Foncar", "Phuong Car of Kyoto"],
      "description": "京都市南区の自動車板金塗装、キズへこみ修理、車検整備、中古車販売専門店。自社塗装ブース完備・職人直営・適正価格。",
      "image": "https://garage-project-rose.vercel.app/news/banner_before_after.png",
      "url": "https://garage-project-rose.vercel.app/",
      "sameAs": [
        "https://www.facebook.com/Hfoncar/",
        "https://www.threads.com/@hfoncar0895",
        "https://line.me/ti/p/8p-gWS228_",
        "https://maps.app.goo.gl/NAFufmcxXGNwsGap9"
      ],
      "telephone": "+81 90-8234-3176",
      "email": "Hfoncar@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "久世上久世町411-2",
        "addressLocality": "京都市南区",
        "addressRegion": "京都府",
        "postalCode": "601-8212",
        "addressCountry": "JP"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "34.9631239",
        "longitude": "135.7134296"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "reviewCount": "29",
        "bestRating": "5",
        "worstRating": "1"
      },
      "openingHours": "Mo-Sa 09:00-19:00",
      "priceRange": "¥¥"
    }
    </script>
    
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>