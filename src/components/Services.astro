---
// Services Component - Kyoto no Fonkar
---

<section class="services" id="services" itemscope itemtype="https://schema.org/AutoRepair">
  <div class="services-container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="title-decoration">━</span>
        <span class="lang" data-ja="主なサービス" data-vn="Dịch Vụ Chính">主なサービス</span>
        <span class="title-decoration">━</span>
      </h2>
      <p class="section-subtitle lang" 
         data-ja="熟練の職人技と専用設備でお客様の愛車をトータルサポートいたします" 
         data-vn="Đội ngũ kỹ thuật viên giàu kinh nghiệm cùng trang thiết bị hiện đại chăm sóc toàn diện cho xe của bạn">
        熟練の職人技と専用設備でお客様の愛車をトータルサポートいたします
      </p>
    </div>
    
    <div class="service-items">
      <!-- Service 1: Inspection -->
      <a href="/services/inspection" class="service-link">
        <article class="service-item" itemscope itemtype="https://schema.org/Service">
          <div class="service-image-wrap">
            <img src="/news/threads_De5Qc_EE6Xp.jpg" 
                 alt="車検・点検 - 京都のフォンカー" 
                 itemprop="image" 
                 loading="lazy" />
          </div>
          
          <div class="service-content">
            <div class="service-header-row">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/>
                  <circle cx="7" cy="17" r="2"/>
                  <path d="M9 17h6"/>
                  <circle cx="17" cy="17" r="2"/>
                  <path d="m9 11 2 2 4-4"/>
                </svg>
              </div>
              <div class="service-titles">
                <h3 class="service-title lang" data-ja="車検・点検" data-vn="Bảo Dưỡng & Đăng Kiểm" itemprop="name">車検・点検</h3>
                <span class="service-subtitle-tag lang" data-ja="法定車検・安全点検" data-vn="Đăng kiểm định kỳ & Bảo dưỡng an toàn">法定車検・安全点検</span>
              </div>
            </div>
            
            <p class="service-description lang" 
               data-ja="法定車検から定期点検まで、国家基準に適合した安心・確実な点検整備を実施。事前のお見積もりも明確で安心です。"
               data-vn="Từ đăng kiểm định kỳ theo luật Nhật Bản đến bảo dưỡng an toàn toàn diện, kiểm tra chi tiết các hạng mục và báo giá rõ ràng trước khi làm.">
              法定車検から定期点検まで、国家基準に適合した安心・確実な点検整備を実施。事前のお見積もりも明確で安心です。
            </p>
            
            <div class="service-features">
              <span class="feature lang" data-ja="法定車検" data-vn="Đăng kiểm định kỳ">法定車検</span>
              <span class="feature lang" data-ja="定期点検" data-vn="Bảo dưỡng định kỳ">定期点検</span>
              <span class="feature lang" data-ja="事前見積無料" data-vn="Báo giá miễn phí">事前見積無料</span>
            </div>
            
            <div class="service-cta-btn">
              <span class="lang" data-ja="詳しく見る ➜" data-vn="Xem chi tiết dịch vụ ➜">詳しく見る ➜</span>
            </div>
            <meta itemprop="description" content="法定車検と定期点検サービス" />
          </div>
        </article>
      </a>
      
      <!-- Service 2: Body Repair -->
      <a href="/services/repair" class="service-link">
        <article class="service-item" itemscope itemtype="https://schema.org/Service">
          <div class="service-image-wrap">
            <img src="/news/hiace.jpg" 
                 alt="鈑金・修理 - 車体修復と面出し成形" 
                 itemprop="image" 
                 loading="lazy" />
          </div>
          
          <div class="service-content">
            <div class="service-header-row">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
                </svg>
              </div>
              <div class="service-titles">
                <h3 class="service-title lang" data-ja="鈑金・修理" data-vn="Đồng Sơn & Sửa Chữa" itemprop="name">鈑金・修理</h3>
                <span class="service-subtitle-tag lang" data-ja="キズへこみ・事故修復" data-vn="Gò nắn móp méo & Phục hồi xe tai nạn">キズへこみ・事故修復</span>
              </div>
            </div>
            
            <p class="service-description lang" 
               data-ja="事故による大きな損傷から小さな擦り傷・へこみまで、熟練の職人技で緻密に面出し・成形し美しく元通りに修復します。"
               data-vn="Xử lý triệt để từ vết cọ quẹt, móp méo thân vỏ cho đến xe tai nạn nặng, kỹ thuật viên gò nắn phục hồi chuẩn form zin như mới.">
              事故による大きな損傷から小さな擦り傷・へこみまで、熟練の職人技で緻密に面出し・成形し美しく元通りに修復します。
            </p>
            
            <div class="service-features">
              <span class="feature lang" data-ja="事故車修理" data-vn="Sửa xe va chạm">事故車修理</span>
              <span class="feature lang" data-ja="キズ・へこみ" data-vn="Vết móp & trầy xước">キズ・へこみ</span>
              <span class="feature lang" data-ja="フレーム修正" data-vn="Kéo nắn khung sườn">フレーム修正</span>
            </div>
            
            <div class="service-cta-btn">
              <span class="lang" data-ja="詳しく見る ➜" data-vn="Xem chi tiết dịch vụ ➜">詳しく見る ➜</span>
            </div>
            <meta itemprop="description" content="車体の損傷修理と形状復元" />
          </div>
        </article>
      </a>
      
      <!-- Service 3: Painting -->
      <a href="/services/painting" class="service-link">
        <article class="service-item" itemscope itemtype="https://schema.org/Service">
          <div class="service-image-wrap">
            <img src="/news/post1_3.jpg" 
                 alt="塗装・美装 - 高品位焼付塗装" 
                 itemprop="image" 
                 loading="lazy" />
          </div>
          
          <div class="service-content">
            <div class="service-header-row">
              <div class="service-icon-box" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="13.5" cy="6.5" r=".5" fill="currentColor"/>
                  <circle cx="17.5" cy="10.5" r=".5" fill="currentColor"/>
                  <circle cx="8.5" cy="7.5" r=".5" fill="currentColor"/>
                  <circle cx="6.5" cy="12.5" r=".5" fill="currentColor"/>
                  <path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.563-2.512 5.563-5.563C22 6.5 17.5 2 12 2z"/>
                </svg>
              </div>
              <div class="service-titles">
                <h3 class="service-title lang" data-ja="塗装・美装" data-vn="Sơn Xe & Làm Đẹp" itemprop="name">塗装・美装</h3>
                <span class="service-subtitle-tag lang" data-ja="調色・専用ブース焼付" data-vn="Pha sơn vi tính & Sấy hấp buồng nhiệt">調色・専用ブース焼付</span>
              </div>
            </div>
            
            <p class="service-description lang" 
               data-ja="高度な調色技術と専用ブース内での焼き付け塗装により、色ムラのない深みある艶と新車同様の輝きを再現いたします。"
               data-vn="Pha sơn chuẩn màu 100% bằng vi tính, thực hiện trong phòng sơn sấy hấp chuyên dụng, tạo độ bóng sâu và bền màu vượt trội.">
              高度な調色技術と専用ブース内での焼き付け塗装により、色ムラのない深みある艶と新車同様の輝きを再現いたします。
            </p>
            
            <div class="service-features">
              <span class="feature lang" data-ja="全塗装" data-vn="Sơn đổi màu toàn xe">全塗装</span>
              <span class="feature lang" data-ja="部分補修塗装" data-vn="Sơn dặm vá nhanh">部分補修塗装</span>
              <span class="feature lang" data-ja="高耐久クリア" data-vn="Phủ bóng 2K cao cấp">高耐久クリア</span>
            </div>
            
            <div class="service-cta-btn">
              <span class="lang" data-ja="詳しく見る ➜" data-vn="Xem chi tiết dịch vụ ➜">詳しく見る ➜</span>
            </div>
            <meta itemprop="description" content="車体塗装と美装仕上げサービス" />
          </div>
        </article>
      </a>
    </div>
  </div>
</section>

<style>
.services {
  scroll-margin-top: 85px;
  padding: 70px 20px 80px;
  background: #fbfbfb;
  border-top: 1px solid #ebebeb;
  border-bottom: 1px solid #ebebeb;
}

.services-container {
  max-width: 1200px;
  margin: 0 auto;
  width: 100%;
  box-sizing: border-box;
}

.section-header {
  text-align: center;
  margin-bottom: 45px;
}

.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  font-size: clamp(24px, 4vw, 32px);
  color: #1a1a1a;
  margin: 0 0 12px;
  font-family: 'Noto Serif JP', serif;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-align: center;
}

.title-decoration {
  color: var(--primary-red, #c8102e);
  font-weight: 300;
}

.section-subtitle {
  color: #333333;
  font-size: 15.5px;
  font-weight: 500;
  max-width: 650px;
  margin: 0 auto;
  line-height: 1.7;
}

/* 3 Balanced Columns on Desktop */
.service-items {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 28px;
  width: 100%;
  box-sizing: border-box;
}

.service-link {
  text-decoration: none;
  color: inherit;
  display: flex;
  height: 100%;
}

.service-item {
  background: #ffffff;
  border-radius: 16px;
  overflow: hidden;
  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.06);
  border: 1px solid #e5e7eb;
  transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.service-link:hover .service-item {
  transform: translateY(-6px);
  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.12);
  border-color: var(--accent-gold, #d4af37);
}

/* Image Wrap - Real Threads photos unobstructed */
.service-image-wrap {
  height: 210px;
  overflow: hidden;
  position: relative;
  background: #f0f0f0;
}

.service-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
  display: block;
}

.service-link:hover .service-image-wrap img {
  transform: scale(1.05);
}

/* Card Content - Clean, High Contrast */
.service-content {
  padding: 24px 22px 20px;
  flex-grow: 1;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #ffffff;
}

.service-header-row {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 14px;
}

.service-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(200, 16, 46, 0.08);
  color: var(--primary-red, #c8102e);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.service-link:hover .service-icon-box {
  background: var(--primary-red, #c8102e);
  color: #ffffff;
  transform: scale(1.08);
}

.service-titles {
  display: flex;
  flex-direction: column;
}

.service-title {
  font-size: 20px;
  font-weight: 700;
  margin: 0;
  color: #111111;
  font-family: 'Noto Serif JP', serif;
  line-height: 1.3;
}

.service-subtitle-tag {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--primary-red, #c8102e);
  margin-top: 3px;
  display: block;
}

.service-description {
  color: #2c2c2c;
  line-height: 1.75;
  font-size: 14px;
  font-weight: 400;
  margin: 0 0 18px;
  flex-grow: 1;
}

/* Feature tags */
.service-features {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  margin-bottom: 20px;
}

.feature {
  background: #f5f6f8;
  color: #222222;
  border: 1px solid #dcdfe4;
  padding: 5px 12px;
  border-radius: 14px;
  font-size: 12px;
  font-weight: 600;
  white-space: nowrap;
}

/* Solid, High-Contrast CTA Button */
.service-cta-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary-red, #c8102e);
  color: #ffffff !important;
  padding: 12px 18px;
  border-radius: 25px;
  font-weight: 700;
  font-size: 14px;
  letter-spacing: 0.03em;
  box-shadow: 0 3px 10px rgba(200, 16, 46, 0.25);
  transition: all 0.3s ease;
  margin-top: auto;
  box-sizing: border-box;
}

.service-cta-btn span {
  color: #ffffff !important;
}

.service-link:hover .service-cta-btn {
  background: var(--secondary-red, #8b0000);
  box-shadow: 0 6px 18px rgba(200, 16, 46, 0.4);
  transform: translateY(-2px);
}

/* Tablet: 3 columns with tighter gap */
@media (max-width: 960px) and (min-width: 681px) {
  .service-items {
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }
  
  .service-image-wrap {
    height: 160px;
  }
  
  .service-content {
    padding: 18px 14px;
  }
  
  .service-title {
    font-size: 17px;
  }
  
  .service-description {
    font-size: 12.5px;
  }
}

/* Mobile: Clean 1-Column Full-Width Cards */
@media (max-width: 680px) {
  .services {
    scroll-margin-top: 75px;
    padding: 50px 14px 60px;
  }
  
  .section-header {
    margin-bottom: 30px;
  }
  
  .section-title {
    font-size: 22px;
    gap: 10px;
  }
  
  .title-decoration {
    display: none;
  }
  
  .section-subtitle {
    font-size: 13.5px;
    padding: 0 4px;
  }
  
  .service-items {
    grid-template-columns: 1fr;
    gap: 24px;
  }
  
  .service-image-wrap {
    height: 195px;
  }
  
  .service-content {
    padding: 20px 18px 16px;
  }
  
  .service-title {
    font-size: 19px;
  }
  
  .service-description {
    font-size: 13.5px;
    line-height: 1.65;
    margin-bottom: 14px;
  }
  
  .service-features {
    gap: 6px;
    margin-bottom: 16px;
  }
  
  .feature {
    font-size: 11.5px;
    padding: 4px 10px;
  }
  
  .service-cta-btn {
    padding: 12px 18px;
    font-size: 13.5px;
  }
}
</style>
