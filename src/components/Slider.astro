<section class="banner" id="home">
  <div class="slides">
    <img src="https://images.unsplash.com/photo-1504328345606-18bbc8c9d7d1?w=1200&h=400&fit=crop&crop=center" alt="日本の自動車整備工場での車検作業" class="slide active" />
    <img src="https://images.unsplash.com/photo-1580273916550-e323be2ae537?w=1200&h=400&fit=crop&crop=center" alt="日本の鈑金塗装工場" class="slide" />
    <img src="https://images.unsplash.com/photo-1619642751034-765dfdf7c58e?w=1200&h=400&fit=crop&crop=center" alt="日本のカーサービス工場内部" class="slide" />
  </div>
  <div class="banner-text">
    <h1 class="lang" data-ja="京都のフォンカー" data-vn="京都のフォンカー - Phuong Car">
      京都のフォンカー
    </h1>
    <p class="banner-sub lang" data-ja="自動車板金塗装・修理・車検 | Phuong Car of Kyoto" data-vn="Chuyên gia đồng sơn Nhật Bản - Japanese Auto Body Experts">
      自動車板金塗装・修理・車検 | Phuong Car of Kyoto
    </p>
  </div>
</section>

<style>
  .banner-sub {
    font-size: clamp(14px, 2.5vw, 20px);
    margin-top: 8px;
    color: #f5e6b3;
    background: rgba(0,0,0,0.4);
    padding: 6px 16px;
    border-radius: 4px;
    display: inline-block;
    backdrop-filter: blur(2px);
    font-weight: 500;
  }
</style>

<script>
  let slides = document.querySelectorAll(".slide");
  let current = 0;
  function showSlide(index){
    slides.forEach(s => s.classList.remove("active"));
    slides[index].classList.add("active");
  }
  setInterval(() => {
    current = (current + 1) % slides.length;
    showSlide(current);
  }, 3000);
</script>