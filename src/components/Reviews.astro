---
import reviews from "../data/reviews.json";
---

<section class="reviews-section" id="reviews">
  <div class="reviews-container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="title-decoration">━</span>
        <span class="lang" data-ja="お客様の声・Google評価" data-vn="Đánh Giá Của Khách Hàng Trên Google">お客様の声・Google評価</span>
        <span class="title-decoration">━</span>
      </h2>
      <p class="section-subtitle lang"
         data-ja="Googleマップにて★4.8（27件）の高評価をいただいております。実際にご利用いただいたお客様の声をご紹介します。"
         data-vn="Được khách hàng tin tưởng đánh giá 4.8★ trên Google Maps. Dưới đây là những cảm nhận thực tế từ khách hàng.">
        Googleマップにて★4.8（27件）の高評価をいただいております。実際にご利用いただいたお客様の声をご紹介します。
      </p>
    </div>

    <!-- Google Rating Summary Badge -->
    <div class="google-summary-card">
      <div class="google-brand">
        <svg class="google-icon" viewBox="0 0 48 48" width="36" height="36">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <div class="google-brand-text">
          <span class="google-name">Google</span>
          <span class="google-type lang" data-ja="クチコミ評価" data-vn="Đánh giá Google Maps">クチコミ評価</span>
        </div>
      </div>

      <div class="rating-display">
        <span class="rating-num">4.8</span>
        <div class="stars-col">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <span class="review-count lang" data-ja="27件のクチコミに基づく" data-vn="Dựa trên 27 lượt đánh giá">27件のクチコミに基づく</span>
        </div>
      </div>

      <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="btn-gmaps-link lang" data-ja="Googleマップで見る ➜" data-vn="Xem trên Google Maps ➜">
        Googleマップで見る ➜
      </a>
    </div>

    <!-- Review Cards Grid -->
    <div class="reviews-grid">
      {reviews.map((rev) => (
        <div class="review-card">
          <div class="review-header">
            <div class="reviewer-avatar">{rev.avatar}</div>
            <div class="reviewer-info">
              <h3 class="reviewer-name">{rev.author}</h3>
              <div class="reviewer-sub">
                <span class="review-date lang" data-ja={rev.date.ja} data-vn={rev.date.vn}>{rev.date.ja}</span>
                <span class="review-verified">✓ Google Maps</span>
              </div>
            </div>
            <div class="card-stars">⭐⭐⭐⭐⭐</div>
          </div>

          {rev.translatedToJa && (
            <div class="translation-notice">
              <span class="trans-icon">🌐</span>
              <span class="trans-text lang" 
                    data-ja="ベトナム語から日本語への翻訳（自動翻訳）" 
                    data-vn="Tự động dịch sang tiếng Nhật cho khách Nhật">
                ベトナム語から日本語への翻訳（自動翻訳）
              </span>
            </div>
          )}

          <p class="review-content lang" data-ja={rev.content.ja} data-vn={rev.content.vn}>
            {rev.content.ja}
          </p>

          {rev.ownerResponse && (
            <div class="owner-reply">
              <div class="reply-header">
                <strong>京都のフォンカー (オーナー)</strong>
                <span class="reply-badge lang" data-ja="返信" data-vn="Phản hồi">返信</span>
              </div>
              <p class="reply-text lang" data-ja={rev.ownerResponse.ja} data-vn={rev.ownerResponse.vn}>
                {rev.ownerResponse.ja}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom Actions -->
    <div class="reviews-footer-cta">
      <p class="lang" data-ja="京都のフォンカーをご利用いただいたお客様のご感想をお待ちしております！" data-vn="Cảm ơn quý khách đã tin tưởng dịch vụ của xưởng!">
        京都のフォンカーをご利用いただいたお客様のご感想をお待ちしております！
      </p>
      <div class="footer-cta-buttons">
        <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="btn-write-review lang" data-ja="✍️ Googleでクチコミを投稿する" data-vn="✍️ Viết đánh giá trên Google Maps">
          ✍️ Googleでクチコミを投稿する
        </a>
        <a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener" class="btn-contact-rev lang" data-ja="💬 LINEで修理の無料相談" data-vn="💬 Tư vấn sửa xe qua LINE">
          💬 LINEで修理の無料相談
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    padding: 70px 20px 80px;
    background: #fafafc;
    border-top: 1px solid #eee;
  }

  .reviews-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    font-size: clamp(24px, 4vw, 32px);
    color: var(--dark-gray);
    margin-bottom: 15px;
    font-family: 'Noto Serif JP', serif;
  }

  .section-subtitle {
    color: #666;
    font-size: 15px;
    font-weight: 300;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* Google Summary Card */
  .google-summary-card {
    background: white;
    border-radius: 16px;
    padding: 22px 30px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    border: 1px solid #eef0f3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 45px;
    flex-wrap: wrap;
  }

  .google-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .google-brand-text {
    display: flex;
    flex-direction: column;
  }

  .google-name {
    font-size: 18px;
    font-weight: 700;
    color: #3c4043;
    line-height: 1.2;
  }

  .google-type {
    font-size: 12px;
    color: #70757a;
  }

  .rating-display {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .rating-num {
    font-size: 38px;
    font-weight: 800;
    color: #202124;
    line-height: 1;
  }

  .stars-col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stars {
    font-size: 16px;
    letter-spacing: 2px;
  }

  .review-count {
    font-size: 12px;
    color: #5f6368;
    font-weight: 500;
  }

  .btn-gmaps-link {
    background: #1a73e8;
    color: white;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 25px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(26, 115, 232, 0.3);
  }

  .btn-gmaps-link:hover {
    background: #1557b0;
    transform: translateY(-2px);
  }

  /* Reviews Grid */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 25px;
    margin-bottom: 50px;
  }

  .review-card {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    border: 1px solid #f0f0f4;
    display: flex;
    flex-direction: column;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .review-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
  }

  .reviewer-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-red, #c8102e), #8b0000);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .reviewer-info {
    flex-grow: 1;
    min-width: 0;
  }

  .reviewer-name {
    font-size: 15px;
    font-weight: 700;
    color: #202124;
    margin: 0 0 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .reviewer-sub {
    display: flex;
    gap: 8px;
    font-size: 11px;
    color: #888;
  }

  .review-verified {
    color: #1a73e8;
    font-weight: 600;
  }

  .card-stars {
    font-size: 13px;
    letter-spacing: 1px;
    flex-shrink: 0;
  }

  /* Translation Badge */
  .translation-notice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #eef4ff;
    border: 1px solid #d2e3fc;
    color: #1967d2;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 12px;
    width: fit-content;
  }

  .trans-icon {
    font-size: 12px;
  }

  .review-content {
    font-size: 14px;
    color: #3c4043;
    line-height: 1.7;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  /* Owner Reply */
  .owner-reply {
    background: #f8f9fa;
    border-left: 3px solid var(--accent-gold, #d4af37);
    padding: 12px 14px;
    border-radius: 0 8px 8px 0;
    font-size: 12px;
  }

  .reply-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
    color: #202124;
  }

  .reply-badge {
    background: #e8eaed;
    color: #5f6368;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
  }

  .reply-text {
    color: #555;
    margin: 0;
    line-height: 1.6;
  }

  /* Footer CTA */
  .reviews-footer-cta {
    background: white;
    border-radius: 16px;
    padding: 35px 25px;
    text-align: center;
    border: 1px solid #f0f0f4;
  }

  .reviews-footer-cta p {
    font-size: 15px;
    color: #555;
    margin: 0 0 20px;
    font-weight: 500;
  }

  .footer-cta-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-write-review {
    background: #1a73e8;
    color: white;
    text-decoration: none;
    padding: 11px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s;
    box-shadow: 0 3px 10px rgba(26, 115, 232, 0.25);
  }

  .btn-write-review:hover {
    background: #1557b0;
    transform: translateY(-2px);
  }

  .btn-contact-rev {
    background: #06c755;
    color: white;
    text-decoration: none;
    padding: 11px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s;
    box-shadow: 0 3px 10px rgba(6, 199, 85, 0.25);
  }

  .btn-contact-rev:hover {
    background: #05b04c;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .reviews-grid {
      grid-template-columns: 1fr;
    }

    .google-summary-card {
      flex-direction: column;
      text-align: center;
      gap: 15px;
    }

    .rating-display {
      flex-direction: column;
      gap: 5px;
    }
  }
</style>