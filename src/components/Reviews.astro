---
import reviews from "../data/reviews.json";
---

<section class="reviews-section" id="reviews">
  <div class="reviews-container">
    <div class="section-header">
      <h2 class="section-title">
        <span class="title-decoration">━</span>
        <span class="lang" data-ja="お客様の声・Google評価" data-vn="Đánh Giá Của Khách Hàng Trên Google">お客様の声・Google評価</span>
        <span class="title-decoration">━</span>
      </h2>
      <p class="section-subtitle lang"
         data-ja="Googleマップにて★4.8（27件）の高評価をいただいております。実際にご利用いただいたお客様の声をご紹介します。"
         data-vn="Được khách hàng tin tưởng đánh giá 4.8★ trên Google Maps. Dưới đây là những cảm nhận thực tế từ khách hàng.">
        Googleマップにて★4.8（27件）の高評価をいただいております。実際にご利用いただいたお客様の声をご紹介します。
      </p>
    </div>

    <!-- Google Rating Summary Badge -->
    <div class="google-summary-card">
      <div class="google-brand">
        <svg class="google-icon" viewBox="0 0 48 48" width="36" height="36">
          <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
          <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
          <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
          <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
        </svg>
        <div class="google-brand-text">
          <span class="google-name">Google</span>
          <span class="google-type lang" data-ja="クチコミ評価" data-vn="Đánh giá Google Maps">クチコミ評価</span>
        </div>
      </div>

      <div class="rating-display">
        <span class="rating-num">4.8</span>
        <div class="stars-col">
          <div class="stars">⭐⭐⭐⭐⭐</div>
          <span class="review-count lang" data-ja="27件のクチコミに基づく" data-vn="Dựa trên 27 lượt đánh giá">27件のクチコミに基づく</span>
        </div>
      </div>

      <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="btn-gmaps-link lang" data-ja="Googleマップで見る ➜" data-vn="Xem trên Google Maps ➜">
        Googleマップで見る ➜
      </a>
    </div>

    <!-- Review Cards Grid -->
    <div class="reviews-grid">
      {reviews.map((rev) => (
        <div class="review-card">
          <div class="review-header">
            <div class="reviewer-avatar">{rev.avatar}</div>
            <div class="reviewer-info">
              <div class="reviewer-main">
                <h3 class="reviewer-name">{rev.author}</h3>
                <div class="card-stars" aria-label="5つ星">⭐⭐⭐⭐⭐</div>
              </div>
              <div class="reviewer-sub">
                <span class="review-date lang" data-ja={rev.date.ja} data-vn={rev.date.vn}>{rev.date.ja}</span>
                <span class="review-dot">•</span>
                <span class="review-verified">✓ Google Maps</span>
              </div>
            </div>
          </div>

          {rev.translatedToJa && (
            <div class="translation-notice">
              <span class="trans-icon">🌐</span>
              <span class="trans-text lang" 
                    data-ja="ベトナム語から日本語への翻訳（自動翻訳）" 
                    data-vn="Tự động dịch sang tiếng Nhật cho khách Nhật">
                ベトナム語から日本語への翻訳（自動翻訳）
              </span>
            </div>
          )}

          <p class="review-content lang" data-ja={rev.content.ja} data-vn={rev.content.vn}>
            {rev.content.ja}
          </p>

          {rev.ownerResponse && (
            <div class="owner-reply">
              <div class="reply-header">
                <strong>京都のフォンカー (オーナー)</strong>
                <span class="reply-badge lang" data-ja="返信" data-vn="Phản hồi">返信</span>
              </div>
              <p class="reply-text lang" data-ja={rev.ownerResponse.ja} data-vn={rev.ownerResponse.vn}>
                {rev.ownerResponse.ja}
              </p>
            </div>
          )}
        </div>
      ))}
    </div>

    <!-- Bottom Actions -->
    <div class="reviews-footer-cta">
      <p class="lang" data-ja="京都のフォンカーをご利用いただいたお客様のご感想をお待ちしております！" data-vn="Cảm ơn quý khách đã tin tưởng dịch vụ của xưởng!">
        京都のフォンカーをご利用いただいたお客様のご感想をお待ちしております！
      </p>
      <div class="footer-cta-buttons">
        <a href="https://maps.app.goo.gl/NAFufmcxXGNwsGap9" target="_blank" rel="noopener" class="btn-write-review lang" data-ja="✍️ Googleでクチコミを投稿する" data-vn="✍️ Viết đánh giá trên Google Maps">
          ✍️ Googleでクチコミを投稿する
        </a>
        <a href="https://line.me/ti/p/nXJpbtsfDY" target="_blank" rel="noopener" class="btn-contact-rev">
          <svg class="brand-icon line-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#06C755" d="M21.99 10.45c0-4.66-4.57-8.45-10.19-8.45C6.18 2 1.61 5.79 1.61 10.45c0 4.18 3.65 7.68 8.58 8.31.33.07.79.22.9.51.11.26.07.67.03.93l-.15.89c-.04.26-.2 1.01.89.55 1.08-.46 5.86-3.45 8-5.9 1.4-1.57 2.13-3.23 2.13-5.29z"/><path fill="#FFFFFF" d="M9.48 13.06H7.13a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v3.32h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47zm2.46-.47a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm4.94 0a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.4-.22l-1.74-2.45v2.2a.47.47 0 0 1-.47.47h-.78a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h.78c.16 0 .31.08.4.22l1.74 2.44V8.53c0-.26.21-.47.47-.47h.78c.26 0 .47.21.47.47v4.06zm3.5-2.77a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27a.47.47 0 0 1-.47.47h-2.35a.47.47 0 0 1-.47-.47V8.53c0-.26.21-.47.47-.47h2.35c.26 0 .47.21.47.47v.27a.47.47 0 0 1-.47.47h-1.1v.79h1.1a.47.47 0 0 1 .47.47v.27z"/></svg>
          <span class="lang" data-ja="LINEで修理の無料相談" data-vn="Tư vấn sửa xe qua LINE">LINEで修理の無料相談</span>
        </a>
        <a href="https://www.facebook.com/Hfoncar/" target="_blank" rel="noopener" class="btn-fb-rev">
          <svg class="brand-icon fb-icon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path fill="#1877F2" d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/><path fill="#FFFFFF" d="M16.671 15.543l.532-3.47h-3.328v-2.25c0-.949.465-1.874 1.956-1.874h1.514V4.996s-1.374-.235-2.686-.235c-2.741 0-4.533 1.662-4.533 4.669v2.643H7.078v3.47h3.047v8.385a12.09 12.09 0 0 0 3.75 0v-8.385h2.796z"/></svg>
          <span class="lang" data-ja="Facebookで相談" data-vn="Tư vấn qua Facebook">Facebookで相談</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews-section {
    scroll-margin-top: 85px;
    padding: 70px 20px 80px;
    background: #fafafc;
    border-top: 1px solid #eee;
    overflow-x: hidden;
  }

  .reviews-container {
    max-width: 1200px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .section-header {
    text-align: center;
    margin-bottom: 35px;
  }

  .section-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    font-size: clamp(22px, 4vw, 32px);
    color: var(--dark-gray);
    margin-bottom: 15px;
    font-family: 'Noto Serif JP', serif;
    flex-wrap: wrap;
    text-align: center;
  }

  .section-subtitle {
    color: #666;
    font-size: 15px;
    font-weight: 300;
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.8;
  }

  /* Google Summary Card */
  .google-summary-card {
    background: white;
    border-radius: 16px;
    padding: 22px 30px;
    box-shadow: 0 4px 18px rgba(0,0,0,0.06);
    border: 1px solid #eef0f3;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 45px;
    flex-wrap: wrap;
    box-sizing: border-box;
  }

  .google-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .google-brand-text {
    display: flex;
    flex-direction: column;
  }

  .google-name {
    font-size: 18px;
    font-weight: 700;
    color: #3c4043;
    line-height: 1.2;
  }

  .google-type {
    font-size: 12px;
    color: #70757a;
  }

  .rating-display {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .rating-num {
    font-size: 38px;
    font-weight: 800;
    color: #202124;
    line-height: 1;
  }

  .stars-col {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .stars {
    font-size: 16px;
    letter-spacing: 2px;
    line-height: 1;
  }

  .review-count {
    font-size: 12px;
    color: #5f6368;
    font-weight: 500;
  }

  .btn-gmaps-link {
    background: #1a73e8;
    color: white;
    text-decoration: none;
    padding: 10px 22px;
    border-radius: 25px;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(26, 115, 232, 0.3);
    white-space: nowrap;
  }

  .btn-gmaps-link:hover {
    background: #1557b0;
    transform: translateY(-2px);
  }

  /* Reviews Grid */
  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 24px;
    margin-bottom: 50px;
    width: 100%;
    box-sizing: border-box;
  }

  .review-card {
    background: white;
    border-radius: 14px;
    padding: 24px;
    box-shadow: 0 2px 12px rgba(0,0,0,0.04);
    border: 1px solid #f0f0f4;
    display: flex;
    flex-direction: column;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    overflow-wrap: break-word;
    word-break: break-word;
  }

  .review-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
  }

  .review-header {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
    min-width: 0;
    width: 100%;
  }

  .reviewer-avatar {
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-red, #c8102e), #8b0000);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 17px;
    font-weight: 700;
    flex-shrink: 0;
  }

  .reviewer-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .reviewer-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
    min-width: 0;
  }

  .reviewer-name {
    font-size: 15px;
    font-weight: 700;
    color: #202124;
    margin: 0;
    line-height: 1.3;
    word-break: break-word;
  }

  .reviewer-sub {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11.5px;
    color: #70757a;
    flex-wrap: wrap;
    margin-top: 2px;
  }

  .review-dot {
    color: #bbb;
  }

  .review-verified {
    color: #1a73e8;
    font-weight: 600;
  }

  .card-stars {
    font-size: 13px;
    letter-spacing: 1px;
    line-height: 1;
    flex-shrink: 0;
  }

  /* Translation Badge */
  .translation-notice {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #eef4ff;
    border: 1px solid #d2e3fc;
    color: #1967d2;
    padding: 4px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    margin-bottom: 12px;
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
    flex-wrap: wrap;
  }

  .trans-icon {
    font-size: 12px;
    flex-shrink: 0;
  }

  .review-content {
    font-size: 14px;
    color: #3c4043;
    line-height: 1.7;
    margin: 0 0 16px;
    flex-grow: 1;
    word-break: break-word;
    overflow-wrap: break-word;
  }

  /* Owner Reply */
  .owner-reply {
    background: #f8f9fa;
    border-left: 3px solid var(--accent-gold, #d4af37);
    padding: 12px 14px;
    border-radius: 0 8px 8px 0;
    font-size: 12px;
    box-sizing: border-box;
    word-break: break-word;
    overflow-wrap: break-word;
    margin-top: auto;
  }

  .reply-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 6px;
    color: #202124;
  }

  .reply-header strong {
    font-size: 12px;
    font-weight: 700;
  }

  .reply-badge {
    background: #e8eaed;
    color: #5f6368;
    font-size: 10px;
    padding: 2px 6px;
    border-radius: 4px;
    flex-shrink: 0;
    font-weight: 600;
  }

  .reply-text {
    color: #555;
    margin: 0;
    line-height: 1.6;
    word-break: break-word;
  }

  /* Footer CTA */
  .reviews-footer-cta {
    background: white;
    border-radius: 16px;
    padding: 35px 25px;
    text-align: center;
    border: 1px solid #f0f0f4;
    box-sizing: border-box;
  }

  .reviews-footer-cta p {
    font-size: 15px;
    color: #555;
    margin: 0 0 20px;
    font-weight: 500;
    line-height: 1.6;
  }

  .footer-cta-buttons {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn-write-review,
  .btn-contact-rev,
  .btn-fb-rev {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    justify-content: center;
    text-decoration: none;
    padding: 11px 24px;
    border-radius: 25px;
    font-size: 14px;
    font-weight: 600;
    transition: all 0.3s;
    box-sizing: border-box;
  }

  .btn-write-review {
    background: #1a73e8;
    color: white;
    box-shadow: 0 3px 10px rgba(26, 115, 232, 0.25);
  }

  .btn-write-review:hover {
    background: #1557b0;
    transform: translateY(-2px);
  }

  .btn-contact-rev {
    background: #06c755;
    color: white;
    box-shadow: 0 3px 10px rgba(6, 199, 85, 0.25);
  }

  .btn-contact-rev:hover {
    background: #05b04c;
    transform: translateY(-2px);
  }

  .btn-fb-rev {
    background: #1877f2;
    color: white;
    box-shadow: 0 3px 10px rgba(24, 119, 242, 0.25);
  }

  .btn-fb-rev:hover {
    background: #166fe5;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .reviews-section {
      scroll-margin-top: 75px;
      padding: 50px 16px 60px;
    }

    .reviews-grid {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 35px;
    }

    .review-card {
      padding: 18px 16px;
      border-radius: 12px;
    }

    .google-summary-card {
      flex-direction: column;
      text-align: center;
      gap: 16px;
      padding: 20px 16px;
      margin-bottom: 30px;
    }

    .rating-display {
      flex-direction: column;
      gap: 6px;
    }

    .btn-gmaps-link {
      width: 100%;
      max-width: 260px;
      text-align: center;
    }

    .reviews-footer-cta {
      padding: 26px 16px;
    }

    .reviews-footer-cta p {
      font-size: 14px;
      margin-bottom: 16px;
    }

    .footer-cta-buttons {
      flex-direction: column;
      gap: 10px;
      width: 100%;
    }

    .footer-cta-buttons a {
      width: 100%;
      padding: 12px 18px;
      font-size: 13.5px;
    }
  }

  @media (max-width: 480px) {
    .reviews-section {
      padding: 45px 12px 50px;
    }

    .section-title {
      font-size: 20px;
      gap: 8px;
    }

    .title-decoration {
      display: none;
    }

    .section-subtitle {
      font-size: 13px;
      line-height: 1.6;
    }

    .review-card {
      padding: 16px 12px;
    }

    .reviewer-avatar {
      width: 38px;
      height: 38px;
      font-size: 15px;
    }

    .reviewer-name {
      font-size: 14px;
    }

    .card-stars {
      font-size: 12px;
    }

    .review-content {
      font-size: 13.5px;
      margin-bottom: 12px;
    }

    .owner-reply {
      padding: 10px 12px;
      font-size: 11.5px;
    }
  }
</style>
