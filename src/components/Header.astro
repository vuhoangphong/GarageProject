<header>
  <a href="/" class="logo-link" aria-label="京都のフォンカー - Phuong Car of Kyoto">
    <div class="logo">
      <svg class="header-logo-svg" viewBox="0 0 340 68" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="京都のフォンカー - Phuong Car of Kyoto">
        <title>京都のフォンカー - Phuong Car of Kyoto</title>
        <defs>
          <linearGradient id="hdrGoldMain" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#fff5d1" />
            <stop offset="18%" stop-color="#f9e08f" />
            <stop offset="48%" stop-color="#deb243" />
            <stop offset="78%" stop-color="#b98421" />
            <stop offset="100%" stop-color="#84570b" />
          </linearGradient>
          <linearGradient id="hdrGoldSub" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#fff2c8" />
            <stop offset="35%" stop-color="#ebd185" />
            <stop offset="75%" stop-color="#c9972d" />
            <stop offset="100%" stop-color="#885e0e" />
          </linearGradient>
          <filter id="hdrLogoShadow" x="-15%" y="-15%" width="130%" height="135%">
            <feDropShadow dx="0" dy="1.8" stdDeviation="1.4" flood-color="#000000" flood-opacity="0.65" />
          </filter>
        </defs>
        <g filter="url(#hdrLogoShadow)">
          <text x="170" y="40" text-anchor="middle" class="hdr-logo-ja">京都のフォンカー</text>
          <text x="170" y="60" text-anchor="middle" class="hdr-logo-en">Phuong Car of Kyoto</text>
        </g>
      </svg>
    </div>
  </a>
  <button class="mobile-menu" id="mobileToggle">☰</button>
  <nav id="navigation">
    <a href="/#home" class="nav-link">
      <span class="nav-text langHeaderSerive" data-ja="ホーム" data-vn="Trang Chủ">ホーム</span>
    </a>
    <a href="/#services" class="nav-link">
      <span class="nav-text langHeaderSerive" data-ja="サービス" data-vn="Dịch Vụ">サービス</span>
    </a>
    <a href="/news" class="nav-link">
      <span class="nav-text langHeaderSerive" data-ja="最新情報" data-vn="Tin Mới">最新情報</span>
    </a>
    <a href="/#reviews" class="nav-link">
      <span class="nav-text langHeaderSerive" data-ja="お客様の声" data-vn="Đánh Giá">お客様の声</span>
    </a>
    <a href="/#contact" class="nav-link">
      <span class="nav-text langHeaderSerive" data-ja="お問い合わせ" data-vn="Liên Hệ">お問い合わせ</span>
    </a>
    <button id="toggleLang" class="lang-toggle">
      <img src="/icon_Lang_Japan.png" alt="JP" class="flag-icon" width="16" height="12"> 
      <span>JP</span>
    </button>
  </nav>
  <button id="toggleLangDesktop" class="lang-toggle">
    <img src="/icon_Lang_Japan.png" alt="JP" class="flag-icon" width="16" height="12"> 
    <span>JP</span>
  </button>
</header>

<style>
/* Japanese-style header */
header {
  background: linear-gradient(135deg, var(--primary-red), var(--secondary-red));
  border-bottom: 4px solid var(--accent-gold);
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 15px 20px;
  color: white;
}

/* Hide nav-links on service pages */
body.service-page .service-hidden {
  display: none !important;
}

.logo-link {
  text-decoration: none;
  color: inherit;
  display: inline-flex;
  align-items: center;
  transition: transform 0.25s ease, opacity 0.25s ease;
}

.logo-link:hover {
  opacity: 0.95;
  transform: translateY(-1px);
}

.logo {
  display: flex;
  align-items: center;
}

.header-logo-svg {
  display: block;
  height: 50px;
  width: auto;
  max-width: 260px;
  overflow: visible;
  filter: drop-shadow(0 2px 5px rgba(0,0,0,0.3));
}

.hdr-logo-ja {
  font-family: 'Noto Sans JP', 'M PLUS 1p', 'Hiragino Kaku Gothic ProN', 'Yu Gothic', 'Meiryo', sans-serif;
  font-weight: 900;
  font-size: 40px;
  letter-spacing: 0.04em;
  fill: url(#hdrGoldMain);
  stroke: #4c3107;
  stroke-width: 1.6px;
  stroke-linejoin: round;
  paint-order: stroke fill;
}

.hdr-logo-en {
  font-family: 'Montserrat', 'Arial', -apple-system, BlinkMacSystemFont, sans-serif;
  font-weight: 800;
  font-size: 15px;
  letter-spacing: 0.06em;
  fill: url(#hdrGoldSub);
  stroke: #422a05;
  stroke-width: 0.75px;
  stroke-linejoin: round;
  paint-order: stroke fill;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

.nav-link {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2px;
  text-decoration: none;
  color: white;
  padding: 8px 12px;
  border-radius: 8px;
  transition: all 0.3s ease;
}

.nav-kanji {
  font-size: 16px;
}

.nav-text {
  font-size: 16px;
  font-weight: 600;
}

.nav-link:hover {
  background: rgba(255,255,255,0.15);
  transform: translateY(-1px);
}

.lang-toggle {
  background: rgba(255,255,255,0.9);
  border: 1px solid rgba(255,255,255,0.3);
  border-radius: 20px;
  padding: 6px 12px;
  display: flex;
  align-items: center;
  gap: 4px;
  cursor: pointer;
  transition: all 0.3s ease;
  color: var(--dark-gray);
}

.lang-toggle:hover {
  background: white;
  transform: translateY(-1px);
}

.mobile-menu {
  display: none;
  background: none;
  border: none;
  color: white;
  font-size: 18px;
  cursor: pointer;
}

@media (max-width: 768px) {
  .header-logo-svg {
    height: 42px;
    max-width: 210px;
  }
  header {
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s ease;
    will-change: transform;
  }

  header.header-hidden {
    transform: translateY(-100%);
    box-shadow: none;
  }

  .mobile-menu {
    display: block;
  }
  
  nav {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--primary-red);
    flex-direction: column;
    padding: 20px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    z-index: 1000;
  }
  
  nav.mobile-open {
    display: flex;
  }
  
  .nav-link {
    width: 100%;
    flex-direction: row;
    justify-content: flex-start;
    gap: 10px;
    padding: 15px;
    border-radius: 8px;
    margin-bottom: 5px;
  }
  
  .nav-link:hover {
    background: rgba(255,255,255,0.2);
  }
  
  #toggleLangDesktop {
    display: none;
  }
}

@media (min-width: 769px) {
  #toggleLang {
    display: none;
  }
}
@media (max-width: 480px) {
  .header-logo-svg {
    height: 36px;
    max-width: 175px;
  }
}
</style>

<script>
  const toggleBtn = document.getElementById("toggleLang");
  const toggleBtnDesktop = document.getElementById("toggleLangDesktop");
  const mobileToggle = document.getElementById("mobileToggle");
  const navigation = document.getElementById("navigation");
  
  // Smart language detector: URL query -> localStorage -> Browser/Device language -> Default (Japanese)
  function detectLanguage(): 'jp' | 'vn' {
    try {
      const params = new URLSearchParams(window.location.search);
      const p = params.get('lang')?.toLowerCase();
      if (p === 'vn' || p === 'vi') return 'vn';
      if (p === 'ja' || p === 'jp') return 'jp';
    } catch (e) {}

    try {
      const saved = localStorage.getItem('language');
      if (saved === 'vn' || saved === 'jp') return saved;
    } catch (e) {}

    try {
      const navLangs = navigator.languages || [navigator.language || ''];
      for (const lang of navLangs) {
        const l = (lang || '').toLowerCase();
        if (l.startsWith('vi') || l === 'vn') return 'vn';
        if (l.startsWith('ja') || l === 'jp') return 'jp';
      }
    } catch (e) {}

    return 'jp';
  }

  let isJP = detectLanguage() !== 'vn';

  // Apply language function
  function applyLanguage(targetJP: boolean, saveToStorage: boolean = false) {
    isJP = targetJP;
    if (saveToStorage) {
      try {
        localStorage.setItem('language', isJP ? 'jp' : 'vn');
      } catch (e) {}
    }

    // Translate all elements with data-ja / data-vn
    document.querySelectorAll(".lang, .langHeaderSerive, .langService").forEach(el => {
      const newText = isJP ? el.getAttribute("data-ja") : el.getAttribute("data-vn");
      if (newText) el.textContent = newText;
    });

    // Update contact info grid attribute if present on page
    const contactGrid = document.querySelector('.contact-info-grid');
    if (contactGrid) {
      if (isJP) {
        contactGrid.removeAttribute('data-lang');
      } else {
        contactGrid.setAttribute('data-lang', 'vn');
      }
    }

    updateLanguageButtons();

    // Broadcast languageChanged event for other components
    document.dispatchEvent(new CustomEvent('languageChanged', { detail: isJP ? 'jp' : 'vn' }));
  }

  // Language toggle click
  function switchLanguage() {
    applyLanguage(!isJP, true);
  }

  // Update language buttons UI
  function updateLanguageButtons() {
    const flagSrc = isJP ? "/icon_Lang_Japan.png" : "/icon_Lang_VietNam.png";
    const newText = isJP ? "JP" : "VN";
    
    [toggleBtn, toggleBtnDesktop].forEach(btn => {
      if (btn) {
        const flagIcon = btn.querySelector('.flag-icon');
        const textSpan = btn.querySelector('span');
        if (flagIcon instanceof HTMLImageElement) {
          flagIcon.src = flagSrc;
          flagIcon.alt = newText;
        }
        if (textSpan) textSpan.textContent = newText;
      }
    });
  }

  // Initialize language on page load
  function initLanguage() {
    applyLanguage(isJP, false);
  }

  document.addEventListener('DOMContentLoaded', initLanguage);
  if (document.readyState === 'interactive' || document.readyState === 'complete') {
    initLanguage();
  }

  // Check if current page is a service page and add class to body
  if (window.location.pathname.includes('/services/')) {
    document.body.classList.add('service-page');
  }

  // Attach language toggle to both buttons
  if (toggleBtn) {
    toggleBtn.addEventListener("click", switchLanguage);
  }
  
  if (toggleBtnDesktop) {
    toggleBtnDesktop.addEventListener("click", switchLanguage);
  }

  // Mobile menu toggle
  if (mobileToggle && navigation) {
    mobileToggle.addEventListener("click", () => {
      navigation.classList.toggle("mobile-open");
      mobileToggle.textContent = navigation.classList.contains("mobile-open") ? "✕" : "☰";
    });

    // Close mobile menu when clicking nav links
    navigation.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        navigation.classList.remove('mobile-open');
        mobileToggle.textContent = "☰";
      });
    });
  }

  // Close mobile menu when clicking outside
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    if (navigation && mobileToggle && target &&
        !navigation.contains(target) && 
        !mobileToggle.contains(target)) {
      navigation.classList.remove('mobile-open');
      mobileToggle.textContent = "☰";
    }
  });

  // Smart auto-hide / show header on scroll for mobile
  let lastScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
  let touchStartY = 0;

  function updateHeaderVisibility(newScrollY) {
    const headerEl = document.querySelector('header');
    const isMobile = window.innerWidth <= 768;

    if (!headerEl || !isMobile) return;

    // If mobile menu is open, always keep header visible
    if (navigation && navigation.classList.contains('mobile-open')) {
      headerEl.classList.remove('header-hidden');
      lastScrollY = newScrollY;
      return;
    }

    // Near the top of the page, always show header
    if (newScrollY <= 40) {
      headerEl.classList.remove('header-hidden');
      lastScrollY = newScrollY;
      return;
    }

    const delta = newScrollY - lastScrollY;

    // Scrolling down: hide header
    if (delta > 6) {
      headerEl.classList.add('header-hidden');
      lastScrollY = newScrollY;
    } 
    // Scrolling up: SHOW header immediately!
    else if (delta < -2) {
      headerEl.classList.remove('header-hidden');
      lastScrollY = newScrollY;
    }
  }

  // Native scroll event
  window.addEventListener('scroll', () => {
    const currentScrollY = window.pageYOffset || document.documentElement.scrollTop || 0;
    updateHeaderVisibility(currentScrollY);
  }, { passive: true });

  // Touch gesture listener for instant mobile response
  window.addEventListener('touchstart', (e) => {
    if (e.touches && e.touches[0]) {
      touchStartY = e.touches[0].clientY;
    }
  }, { passive: true });

  window.addEventListener('touchmove', (e) => {
    if (!e.touches || !e.touches[0]) return;
    const currentTouchY = e.touches[0].clientY;
    const touchDelta = currentTouchY - touchStartY;
    const headerEl = document.querySelector('header');
    const isMobile = window.innerWidth <= 768;

    if (!headerEl || !isMobile) return;

    // If user swipes finger down (scrolls UP towards top) -> SHOW header immediately!
    if (touchDelta > 8) {
      headerEl.classList.remove('header-hidden');
    }
    // If user swipes finger up (scrolls DOWN) -> HIDE header
    else if (touchDelta < -10 && (window.pageYOffset || document.documentElement.scrollTop) > 50) {
      if (navigation && !navigation.classList.contains('mobile-open')) {
        headerEl.classList.add('header-hidden');
      }
    }
  }, { passive: true });
</script>